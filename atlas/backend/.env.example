# =============================================================
# ATLAS Backend – Environment Variables Template
# =============================================================
# Copy this file to .env.development, .env.local, or .env.production
# and fill in all required values.
#
# Required vars (no default): DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET,
# ATLAS_CREDENTIAL_KEY
# Optional vars have safe defaults shown below.
# =============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME=ATLAS API
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Database (PostgreSQL) ────────────────────────────────────
# REQUIRED – no default
DATABASE_URL=postgresql://atlas_user:atlas_password@localhost:5432/atlas_db?schema=public

# ── Cache (Redis) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=atlas_redis_password
REDIS_DB=0

# ── JWT Authentication ───────────────────────────────────────
# REQUIRED – minimum 32 characters each
JWT_SECRET=change-this-to-a-random-256-bit-secret-minimum-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-to-a-different-random-256-bit-secret-min-32
JWT_REFRESH_EXPIRES_IN=30d

# ── Credential Encryption ────────────────────────────────────
# REQUIRED – minimum 32 characters. Encrypts stored marketplace
# provider credentials (e.g. Amazon SP-API client secret/refresh
# token) at rest. Never reuse the JWT secrets for this value.
ATLAS_CREDENTIAL_KEY=change-this-to-a-random-256-bit-secret-minimum-32-chars

# ── Logger ───────────────────────────────────────────────────
# Valid values: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ── Swagger / OpenAPI ────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE=ATLAS API
SWAGGER_DESCRIPTION=ATLAS AI Commerce Operating System API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# ── BullMQ Queue (optional – defaults to Redis config above) ─
# BULLMQ_REDIS_HOST=
# BULLMQ_REDIS_PORT=
# BULLMQ_REDIS_PASSWORD=

# ── Amazon SP-API (global app-level credentials) ─────────────
# ATLAS's own SP-API application clientId/clientSecret — ONE pair
# shared across every workspace/seller account. Per-seller
# refreshToken and sellerId are NOT set here; they are stored per
# workspace via marketplace-provider-credentials (refreshToken,
# encrypted) and marketplace-account (sellerId, plaintext).
# Optional at startup — the app boots without these, but any Amazon
# SP-API call fails until both are set.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
# sandbox | production
AMAZON_SP_API_ENVIRONMENT=sandbox
# Seller Central "Application ID" (Develop Apps) — NOT the same as the LWA
# client ID above. Required to build the Connect Amazon consent URL.
AMAZON_SP_API_APPLICATION_ID=
# Exact callback URL registered with this Amazon app.
AMAZON_SP_API_REDIRECT_URI=
# Sandbox-only global refresh token — used ONLY by the platform-admin
# global sandbox connectivity check (no seller/workspace involved).
# Never used for production or real seller calls.
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=

# ── Platform Admin Bootstrap (operator-run only, one-time) ───
# Consumed ONLY by `npm run bootstrap:platform-admin`
# (scripts/bootstrap-platform-admin.ts) — never read by the running
# application, and never usable via any HTTP endpoint. Uncomment,
# fill in with real values in your local/untracked env file (never
# here), run the script once, then remove them again.
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_FIRST_NAME=
# PLATFORM_ADMIN_LAST_NAME=
# PLATFORM_ADMIN_WORKSPACE_NAME=

