enum AiContextType {
  REQUEST
  SESSION
  WORKFLOW
  AGENT
  TASK
  WORKSPACE
}

enum AiContextStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
  SUMMARIZED
}

enum AiContextPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

model AiContext {
  id                    String                  @id @default(uuid())
  workspaceId           String                  @map("workspace_id")
  
  type                  AiContextType
  status                AiContextStatus         @default(ACTIVE)
  priority              AiContextPriority       @default(NORMAL)
  
  correlationId         String?                 @map("correlation_id")
  parentContextId       String?                 @map("parent_context_id")
  
  userId                String?                 @map("user_id")
  sessionId             String?                 @map("session_id")
  workflowExecutionId   String?                 @map("workflow_execution_id")
  agentExecutionId      String?                 @map("agent_execution_id")
  taskId                String?                 @map("task_id")
  
  variables             Json?
  conversationHistory   Json?                   @map("conversation_history")
  toolResults           Json?                   @map("tool_results")
  businessReferences    Json?                   @map("business_references")
  executionMetadata     Json?                   @map("execution_metadata")
  
  summary               String?                 @db.Text
  
  version               Int                     @default(1)
  sizeBytes             Int?                    @map("size_bytes")
  tokenEstimate         Int?                    @map("token_estimate")
  
  maxTokens             Int?                    @map("max_tokens")
  windowSize            Int?                    @map("window_size")
  
  source                String?
  
  expiresAt             DateTime?               @map("expires_at")
  lastAccessedAt        DateTime?               @map("last_accessed_at")
  
