  metadata                Json                @default("{}")
  createdAt               DateTime            @default(now()) @map("created_at")

  retryExecution          AiRetryExecution    @relation(fields: [retryExecutionId], references: [id], onDelete: Cascade)

  @@index([retryExecutionId])
  @@index([workspaceId])
  @@index([attemptNumber])
  @@index([succeeded])
  @@index([provider])
  @@index([createdAt])
  @@map("ai_retry_attempts")
}

model AiFallbackConfig {
  id                      String              @id @default(uuid())
  workspaceId             String?             @map("workspace_id")

  name                    String
  capability              String
  useCase                 String?             @map("use_case")

