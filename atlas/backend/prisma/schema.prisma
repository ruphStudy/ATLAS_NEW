model OperationsHealthIncident {
  id          String                          @id @default(uuid())
  workspaceId String                          @map("workspace_id")
  module      String
  severity    OperationsHealthStatus
  status      OperationsHealthIncidentStatus  @default(OPEN)

  triggerSummary String @db.Text @map("trigger_summary")
  issues         Json

  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")
  durationMs Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, module])
  @@index([status])
  @@map("operations_health_incidents")
}

/// Immutable — append-only per-check ledger, never updated or deleted afterward.
model OperationsHealthCheckLog {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  module      String

  status         OperationsHealthStatus
  previousStatus OperationsHealthStatus?     @map("previous_status")
  trigger        OperationsHealthCheckTrigger @default(MANUAL)

  queueBacklog      Int     @map("queue_backlog")
  queueFailedCount  Int     @map("queue_failed_count")
  auditFailureCount Int     @map("audit_failure_count")
  issues            Json
  safeSummary       String? @db.Text @map("safe_summary")

