  allowBranching        Boolean                 @default(true) @map("allow_branching")
  
  tags                  String[]
  metadata              Json                    @default("{}")
  
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  deletedAt             DateTime?               @map("deleted_at")
  
  versions              AiContextVersion[]
  cacheEntries          AiContextCache[]
  events                AiContextEvent[]
  
  @@unique([workspaceId, correlationId])
  @@index([workspaceId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([correlationId])
  @@index([parentContextId])
  @@index([userId])
  @@index([sessionId])
  @@index([workflowExecutionId])
  @@index([agentExecutionId])
  @@index([taskId])
  @@index([expiresAt])
  @@index([lastAccessedAt])
  @@index([deletedAt])
  @@map("ai_contexts")
}

model AiContextVersion {
  id                    String              @id @default(uuid())
  contextId             String              @map("context_id")
  workspaceId           String              @map("workspace_id")
  
  version               Int
  
  variables             Json?
  conversationHistory   Json?               @map("conversation_history")
  toolResults           Json?               @map("tool_results")
  businessReferences    Json?               @map("business_references")
  executionMetadata     Json?               @map("execution_metadata")
  
  summary               String?             @db.Text
  
  sizeBytes             Int?                @map("size_bytes")
  tokenEstimate         Int?                @map("token_estimate")
  
  changeReason          String?             @map("change_reason")
  changedBy             String?             @map("changed_by")
  
  metadata              Json                @default("{}")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  
  context               AiContext           @relation(fields: [contextId], references: [id], onDelete: Cascade)
  
  @@unique([contextId, version])
  @@index([contextId])
  @@index([workspaceId])
  @@index([version])
  @@index([createdAt])
  @@map("ai_context_versions")
}

model AiContextCache {
  id                    String              @id @default(uuid())
  contextId             String              @map("context_id")
  workspaceId           String              @map("workspace_id")
  
  cacheKey              String              @map("cache_key")
  
  cachedData            Json                @map("cached_data")
  
