  scheduleCron            String?                        @map("schedule_cron")
  
  batchSize               Int                            @default(100) @map("batch_size")
  maxRetries              Int                            @default(3) @map("max_retries")
  retryDelaySeconds       Int                            @default(60) @map("retry_delay_seconds")
  
  filterByRegion          String?                        @map("filter_by_region")
  filterByChannel         String?                        @map("filter_by_channel")
  filterByMarketplaceAccountId String?                   @map("filter_by_marketplace_account_id")
  filterBySku             String[]                       @map("filter_by_sku")
  
  enabled                 Boolean                        @default(true)
  priority                Int                            @default(0)
  
