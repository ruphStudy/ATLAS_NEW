  fromStatus String?               @map("from_status")
  toStatus   String?               @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([flagKey])
  @@map("feature_flag_history")
}

