model BillingPeriod {
  id             String  @id @default(uuid())
  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")
  subscriptionId String? @map("subscription_id")
  scopeKey       String  @map("scope_key")

  triggerType     BillingTriggerType @default(RENEWAL) @map("trigger_type")
  billingCycle    BillingCycle       @map("billing_cycle")
  customCycleDays Int?               @map("custom_cycle_days")

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  dueDate     DateTime @map("due_date")

  currency String
  status   BillingPeriodStatus @default(DRAFT)

  subtotal        Float @default(0)
  discountTotal   Float @default(0) @map("discount_total")
  creditTotal     Float @default(0) @map("credit_total")
  taxTotal        Float @default(0) @map("tax_total")
  overageTotal    Float @default(0) @map("overage_total")
  adjustmentTotal Float @default(0) @map("adjustment_total")
  total           Float @default(0)
  amountPaid      Float @default(0) @map("amount_paid")
  balanceDue      Float @default(0) @map("balance_due")

  idempotencyKey    String? @map("idempotency_key")
  externalReference Json?   @map("external_reference")
  version           Int     @default(1)

  generatedAt DateTime  @default(now()) @map("generated_at")
  billedAt    DateTime? @map("billed_at")
  paidAt      DateTime? @map("paid_at")
  voidedAt    DateTime? @map("voided_at")
  refundedAt  DateTime? @map("refunded_at")

  voidReason   String? @db.Text @map("void_reason")
  refundReason String? @db.Text @map("refund_reason")

  metadata Json @default("{}")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   BillingItem[]
  history BillingHistory[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([scopeKey])
  @@map("billing_periods")
}

model BillingItem {
  id              String @id @default(uuid())
  billingPeriodId String @map("billing_period_id")
  workspaceId     String @map("workspace_id")

  type        BillingItemType
  description String
  quantity    Float?
  unitAmount  Float?          @map("unit_amount")
  amount      Float
  currency    String

  planKey     String? @map("plan_key")
  resourceKey String? @map("resource_key")

  /// The inputs used to compute this item (e.g. `{fromDate,toDate,dailyRate,daysProrated}` for a proration item, `{resourceKey,usageAmount,limit,overageRate}` for an overage item) — never recomputed implicitly, kept for audit/traceability.
  calculationInput Json? @map("calculation_input")
  metadata         Json  @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)

  @@index([billingPeriodId])
  @@index([workspaceId])
  @@index([type])
  @@map("billing_items")
}

/// Immutable — append-only lifecycle ledger, never updated or deleted afterward.
model BillingHistory {
  id              String @id @default(uuid())
  billingPeriodId String @map("billing_period_id")
  workspaceId     String @map("workspace_id")

  changeType BillingHistoryChangeType @map("change_type")
  fromStatus BillingPeriodStatus?     @map("from_status")
  toStatus   BillingPeriodStatus      @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json

  createdAt DateTime @default(now()) @map("created_at")

  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)

  @@index([billingPeriodId])
  @@index([workspaceId])
  @@map("billing_history")
}

/// Configurable, data-driven billing rules by plan/tenant/country/region — never hardcoded tax rates or overage prices.
model BillingRule {
  id             String            @id @default(uuid())
  scope          BillingRuleScope
  scopeKey       String            @map("scope_key")
  workspaceId    String?           @map("workspace_id")
  organizationId String?           @map("organization_id")
  planKey        String?           @map("plan_key")
  country        String?
  region         String?

  priority Int @default(0)

  taxRatePercent     Float?             @map("tax_rate_percent")
  prorationStrategy  ProrationStrategy  @default(DAILY) @map("proration_strategy")
  gracePeriodDays     Int?              @map("grace_period_days")
  /// Array of `{resourceKey, rate, unit}` — overage price per unit, per resource.
  overageRates        Json?             @map("overage_rates")

  isActive Boolean @default(true) @map("is_active")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scopeKey])
  @@index([workspaceId])
  @@index([planKey])
  @@index([country])
  @@index([region])
  @@map("billing_rules")
}

