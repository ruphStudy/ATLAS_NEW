model MarketplaceListing {
  id                 String                   @id @default(cuid())
  workspaceId        String                   @map("workspace_id")
  universalListingId String                   @map("universal_listing_id")
  catalogProductId   String                   @map("catalog_product_id")
  marketplaceKey     String                   @map("marketplace_key")
  country            String                   @default("GLOBAL")
  status             MarketplaceListingStatus @default(PENDING_TRANSFORMATION)
  version            Int                      @default(1)

