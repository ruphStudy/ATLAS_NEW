/// No Plan/Billing/Payment entity or business logic here by design — `planKey` is an opaque reference into the (separate, not-yet-built) Plan Management catalog, and `prorationReference` is a structured hint only the Billing Engine interprets.
model Subscription {
  id             String            @id @default(uuid())
  scope          SubscriptionScope
  organizationId String?           @map("organization_id")
  workspaceId    String?           @map("workspace_id")
  scopeKey       String            @map("scope_key")

  type          SubscriptionType
  planKey       String                   @map("plan_key")
  billingCycle  SubscriptionBillingCycle @map("billing_cycle")
  customBillingCycleDays Int?            @map("custom_billing_cycle_days")

  status SubscriptionStatus @default(ACTIVE)

  trialStartAt DateTime? @map("trial_start_at")
  trialEndAt   DateTime? @map("trial_end_at")

  startAt            DateTime  @map("start_at")
  endAt              DateTime? @map("end_at")
  currentPeriodStart DateTime  @map("current_period_start")
  currentPeriodEnd   DateTime  @map("current_period_end")
  renewalDate        DateTime? @map("renewal_date")

  gracePeriodDays   Int       @default(0) @map("grace_period_days")
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at")

  autoRenew         Boolean   @default(true) @map("auto_renew")
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt       DateTime? @map("cancelled_at")
  cancellationReason String?  @db.Text @map("cancellation_reason")

  pausedAt    DateTime? @map("paused_at")
  pauseReason String?   @db.Text @map("pause_reason")

  suspendedAt       DateTime? @map("suspended_at")
  suspensionReason  String?   @db.Text @map("suspension_reason")

  /// Pending plan/cycle change awaiting its effective date (PERIOD_END changes) — applied by `processRenewalsAndExpiry`.
  scheduledChange Json?

  /// Structured hint for the Billing Engine (e.g. {fromPlanKey, toPlanKey, changeType, effectiveAt}) — never actual proration math.
  prorationReference Json?

  isAdminOverride     Boolean @default(false) @map("is_admin_override")
  adminOverrideReason String? @db.Text @map("admin_override_reason")

  allowMultipleActive Boolean @default(false) @map("allow_multiple_active")

  metadata Json @default("{}")
  version  Int  @default(1)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history SubscriptionHistory[]

  @@index([scopeKey])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndAt])
  @@map("subscriptions")
}

/// Immutable — append-only lifecycle ledger, never updated or deleted afterward.
model SubscriptionHistory {
  id             String @id @default(uuid())
  subscriptionId String @map("subscription_id")
  scopeKey       String @map("scope_key")

  changeType SubscriptionChangeType @map("change_type")
  fromStatus SubscriptionStatus?    @map("from_status")
  toStatus   SubscriptionStatus     @map("to_status")
  fromPlanKey String?               @map("from_plan_key")
  toPlanKey   String?               @map("to_plan_key")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json

  createdAt DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([scopeKey])
  @@map("subscription_history")
}

