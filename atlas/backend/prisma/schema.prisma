  RESTORED
  ENTITLEMENT_CHANGED
}

/// One row per (code, version) — publishing never mutates a row's entitlements/limits/pricing in place; a change to a PUBLISHED version always creates a new row via `createNewVersion`, so existing subscriptions pinned to an older version keep resolving unchanged terms.
model Plan {
  id      String @id @default(uuid())
  code    String
  version Int    @default(1)

  name        String
  description String? @db.Text
  tier        String
  tierRank    Int      @default(0) @map("tier_rank")
  type        PlanType
  status      PlanStatus @default(DRAFT)

  supportedBillingCycles PlanBillingCycle[] @map("supported_billing_cycles")
  customBillingCycleDays Int?               @map("custom_billing_cycle_days")

  /// Array of `{currency, billingCycle, amount}` — no pricing/currency rules are interpreted here, only stored and exposed for the Billing Engine.
  prices Json @default("[]")

  availableCountries String[] @map("available_countries")
  availableRegions   String[] @map("available_regions")

  /// Array of `{module, feature, capability?, resource?, included, value?}`.
  entitlements Json @default("[]")
  /// Array of `{resourceKey, unit?, soft?, hard?, graceThreshold?, overageRule?}`.
  limits Json @default("[]")

  /// `{requiresPlanCodes?, incompatibleWithPlanCodes?}`.
  dependencies Json?
  /// `{allowedDirectUpgradeCodes?, allowedDirectDowngradeCodes?, blockedTransitions?}`.
  migrationRules Json? @map("migration_rules")

  effectiveAt  DateTime  @default(now()) @map("effective_at")
  publishedAt  DateTime? @map("published_at")
  deprecatedAt DateTime? @map("deprecated_at")
  archivedAt   DateTime? @map("archived_at")

  isSystem Boolean @default(false) @map("is_system")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history PlanHistory[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@index([type])
  @@index([effectiveAt])
  @@map("plans")
}

/// Immutable — append-only lifecycle ledger, never updated or deleted afterward.
model PlanHistory {
  id      String @id @default(uuid())
  planId  String @map("plan_id")
  code    String
  version Int

  changeType PlanChangeType @map("change_type")
  fromStatus PlanStatus?    @map("from_status")
  toStatus   PlanStatus     @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json

  createdAt DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([code])
  @@map("plan_history")
}

