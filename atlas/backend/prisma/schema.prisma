/// The App Store catalog entry — runtime execution of the app itself stays entirely OUTSIDE this module ("keep app-specific runtime logic outside the App Store module"); this only tracks identity, eligibility metadata and lifecycle status. `organizationId` is set only for PRIVATE (single-org) apps; FIRST_PARTY/PARTNER apps are visible platform-wide once PUBLISHED.
model AppListing {
  id   String @id @default(uuid())
  key  String @unique

  name        String
  description String? @db.Text
  category    String

  publisherType AppPublisherType @map("publisher_type")
  publisherName String?          @map("publisher_name")
  publisherId   String?          @map("publisher_id")

  /// Set only for PRIVATE apps — the single tenant this listing is visible to (the workspace-primary scoping every other module this session uses; `organizationId` is carried alongside as the same forward-compatible bare column `Workspace` itself uses).
  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  pricingModel AppPricingModel @map("pricing_model")
  /// `Plan.code` (Plan Management) this app is entitlement-gated by, if any — admin-selected, never resolved by a cross-module lookup at registration time.
  planKey      String?         @map("plan_key")

  regions      String[]
  permissions  String[]
  scopes       String[]
  dependencies String[]

  /// Optional Feature Flags rollout gate — checked via `FeatureFlagsService.evaluate()`, never re-implemented here.
  featureFlagKey String? @map("feature_flag_key")

  currentVersionId String? @map("current_version_id")
  currentVersion   String? @map("current_version")

  status AppListingStatus @default(DRAFT)

  installCount      Int @default(0) @map("install_count")
  activeTenantCount  Int @default(0) @map("active_tenant_count")
  ratingSum          Float @default(0) @map("rating_sum")
  ratingCount        Int   @default(0) @map("rating_count")

  version Int @default(1)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions      AppVersion[]
  installations AppInstallation[]
  reviews       AppReview[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([publisherType])
  @@map("app_listings")
}

/// Immutable-once-published version manifest — `rollback` simply repoints `AppListing.currentVersionId` back to an earlier row here, never mutates a published version in place.
model AppVersion {
  id            String @id @default(uuid())
  appKey        String @map("app_key")
  versionString String @map("version_string")

  /// Snapshot of permissions/scopes/dependencies/changelog at this version — never re-derived from the live listing after publication.
  manifest Json?

  status AppVersionStatus @default(DRAFT)

  publishedAt   DateTime? @map("published_at")
  deprecatedAt  DateTime? @map("deprecated_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing AppListing @relation(fields: [appKey], references: [key], onDelete: Cascade)

  @@unique([appKey, versionString])
  @@index([appKey])
  @@index([status])
  @@map("app_versions")
}

/// Per-tenant install record — `@@unique([appKey, workspaceId])` is what makes "prevent duplicate installations" a DB-enforced guarantee, not just a service-level check. `encryptedCredentials` is AES-256-GCM encrypted at rest (same recipe as every other per-module credential encryptor this session) and is never returned in any response DTO.
model AppInstallation {
  id        String @id @default(uuid())
  appKey    String @map("app_key")
  versionId String @map("version_id")

  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")

  status AppInstallationStatus @default(INSTALLED)

  config              Json?
  encryptedCredentials String? @db.Text @map("encrypted_credentials")

  licenseId      String? @map("license_id")
  subscriptionId String? @map("subscription_id")

  installedAt   DateTime  @default(now()) @map("installed_at")
  enabledAt     DateTime? @map("enabled_at")
  disabledAt    DateTime? @map("disabled_at")
  uninstalledAt DateTime? @map("uninstalled_at")
  lastUsedAt    DateTime? @map("last_used_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing AppListing @relation(fields: [appKey], references: [key], onDelete: Cascade)

  @@unique([appKey, workspaceId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@map("app_installations")
}

/// One review per tenant per app.
model AppReview {
  id     String @id @default(uuid())
  appKey String @map("app_key")

  workspaceId String @map("workspace_id")
  rating      Int
  comment     String? @db.Text

  createdBy String? @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  listing AppListing @relation(fields: [appKey], references: [key], onDelete: Cascade)

  @@unique([appKey, workspaceId])
  @@index([appKey])
  @@map("app_reviews")
}

/// Polymorphic append-only ledger spanning listing/version/installation lifecycle events (discriminated by entityType) — no FK relation since entityId may reference any of the three parent tables.
model AppHistory {
  id          String @id @default(uuid())
  entityType  AppHistoryEntityType @map("entity_type")
  entityId    String @map("entity_id")
  appKey      String @map("app_key")
  workspaceId String? @map("workspace_id")

  changeType AppChangeType @map("change_type")
  fromStatus String?       @map("from_status")
  toStatus   String?       @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([appKey])
  @@map("app_history")
}

