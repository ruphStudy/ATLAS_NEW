// =============================================================
// ATLAS – AI Commerce Operating System
// Prisma Schema
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ENUMS
// =============================================================

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  ANALYST
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
  ARCHIVED
}

enum WorkspaceOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  SERVICE_ACCOUNT
}

enum WorkspaceMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkspacePlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum OpportunityStatus {
  DISCOVERED
  ANALYZING
  VALIDATED
  IN_PROGRESS
  REJECTED
  ARCHIVED
}

enum DiscoverySessionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// How a DiscoveryRun (DiscoverySession) was initiated. KEYWORD is the
/// existing/default behavior; ASIN and TREND_COLD_START are schema slots
/// for future discovery modes — no provider logic for them exists yet.
enum DiscoveryMode {
  KEYWORD
  ASIN
  TREND_COLD_START
}

/// Polymorphic subject a TrendSignal is evidence about.
enum TrendSignalSubjectType {
  CATEGORY
  PRODUCT_CONCEPT
}

/// Distinguishes what a TrendSignal row actually represents — never mix
/// a provider's raw observation with ATLAS's own computed number or an
/// AI-authored explanation in the same classification.
enum TrendSignalClassification {
  RAW_PROVIDER
  ATLAS_DERIVED
  AI_EXPLANATION
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING_REVIEW
  BLACKLISTED
}

enum SupplierManagementStatus {
  PROSPECT
  ACTIVE
  PREFERRED
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum RfqStatus {
  DRAFT
  SENT
  PARTIALLY_RESPONDED
  RESPONDED
  EXPIRED
  CANCELLED
  CLOSED
}

enum RfqSupplierResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTER_OFFERED
}

enum SupplierTier {
  GOLD
  SILVER
  BRONZE
  UNVERIFIED
}

enum SupplierSourceProvider {
  INDIAMART
  TRADEINDIA
  ALIBABA
  MANUAL
}

enum SupplierDiscoverySessionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  REJECTED
  REVIEW_REQUIRED
}

enum VerificationCheckStatus {
  PASSED
  FAILED
  SKIPPED
  MANUAL_OVERRIDE
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CompetitionProvider {
  AMAZON_SEARCH
}

enum ProfitProvider {
  AMAZON_FBA
  AMAZON_FBM
  MANUAL
}

// =============================================================
// MODELS
// =============================================================

// Every business record belongs to a Workspace (DB-002)
model Workspace {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  description String?
  logoUrl     String?         @map("logo_url")
  ownerId     String?         @map("owner_id")
  status      WorkspaceStatus @default(ACTIVE)
  plan        WorkspacePlan   @default(FREE)

  /// Forward-compatible reference only — no Organization entity/relation exists yet in this schema; kept as a bare column so Organization Management can adopt it later without a breaking migration.
  organizationId String? @map("organization_id")

  onboardingStatus      WorkspaceOnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingCompletedAt DateTime?                 @map("onboarding_completed_at")

  archivedAt      DateTime? @map("archived_at")
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @db.Text @map("suspended_reason")

  // Flexible configuration (no schema migrations for settings changes)
  settings Json @default("{}")
  metadata Json @default("{}")

  // Audit fields (DB-004)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  users              User[]
  opportunities      Opportunity[]
  discoverySessions  DiscoverySession[]
  suppliers                 Supplier[]
  supplierDiscoverySessions SupplierDiscoverySession[]
  productAnalyses           ProductAnalysis[]
  competitionAnalyses       CompetitionAnalysis[]
  profitCalculations        ProfitCalculation[]
  productScores             ProductScore[]
  rfqs                      Rfq[]
  quotationComparisons      QuotationComparison[]
  productCostCalculations   ProductCostCalculation[]
  procurements              Procurement[]
  purchaseOrders            PurchaseOrder[]
  shipments                 Shipment[]
  qualityInspections        QualityInspection[]
  catalogProducts           CatalogProduct[]
  aiDescriptions            AiDescription[]
  aiImageSets               AiImageSet[]
  aiSeoOptimizations        AiSeoOptimization[]
  listings                  Listing[]
  listingApprovals          ListingApproval[]
  listingPublications       ListingPublication[]
  supplierProviderConfigs   WorkspaceSupplierProviderConfig[]
  marketplaceMappingConfigs MarketplaceMappingConfig[]
  marketplaceTransformJobs  MarketplaceTransformationJob[]
  universalListings         UniversalListing[]
  marketplaceListings       MarketplaceListing[]
  pricingRecords            PricingRecord[]
  pricingConfigs            PricingConfig[]
  marketplaceProviderConfigs  WorkspaceMarketplaceProviderConfig[]
  marketplaceProviderAccounts MarketplaceProviderAccount[]
  warehouses                  Warehouse[]
  inventoryItems               InventoryItem[]

  @@index([slug])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@map("workspaces")
}

/// Additive alongside `User.workspaceId` (the user's single home workspace, unchanged) — an explicit row here grants access to an ADDITIONAL workspace. A user's home workspace membership is resolved implicitly at the application layer (no backfill required) so existing single-workspace accounts keep working exactly as before.
model WorkspaceMember {
  id          String                @id @default(uuid())
  workspaceId String                @map("workspace_id")
  userId      String                @map("user_id")
  role        WorkspaceMemberRole   @default(MEMBER)
  status      WorkspaceMemberStatus @default(ACTIVE)

  invitedBy String? @map("invited_by")
  joinedAt  DateTime @default(now()) @map("joined_at")
  removedAt DateTime? @map("removed_at")
  removedBy String?   @map("removed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@map("workspace_members")
}

model WorkspaceInvitation {
  id          String                    @id @default(uuid())
  workspaceId String                    @map("workspace_id")
  email       String
  role        WorkspaceMemberRole       @default(MEMBER)
  status      WorkspaceInvitationStatus @default(PENDING)

  token     String   @unique
  invitedBy String   @map("invited_by")
  expiresAt DateTime @map("expires_at")

  acceptedAt       DateTime? @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id")
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([status])
  @@map("workspace_invitations")
}

model User {
  id          String     @id @default(uuid())
  workspaceId String     @map("workspace_id")
  email       String     @unique
  firstName   String     @map("first_name")
  lastName    String     @map("last_name")
  passwordHash String    @map("password_hash")
  role        UserRole   @default(VIEWER)
  status      UserStatus @default(PENDING_VERIFICATION)

  /// True ATLAS-staff cross-tenant access — distinct from the workspace-scoped `role` above. Only checked by Tenant Isolation when a route explicitly opts in (`@AllowPlatformAdmin()`); never grants access on its own.
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")

  // Profile
  avatarUrl String? @map("avatar_url")
  phone     String?
  timezone  String  @default("UTC")
  locale    String  @default("en-US")

  // Auth tracking
  lastLoginAt       DateTime? @map("last_login_at")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  refreshTokenHash  String?   @map("refresh_token_hash")

  /// Password rotation (Amazon SP-API Developer Profile compliance): set on
  /// registration and on every successful password change; checked against
  /// `MAX_PASSWORD_AGE_DAYS` at login/refresh. Never null after the backfill
  /// migration — a null value is treated as already-expired (forces rotation)
  /// rather than silently trusted.
  passwordChangedAt DateTime? @map("password_changed_at")

  /// AES-256-GCM encrypted TOTP secret (see `MfaSecretEncryptor`) — never the
  /// raw base32 secret, never logged, never returned in any response.
  mfaSecret   String?   @map("mfa_secret")
  mfaEnabled  Boolean   @default(false) @map("mfa_enabled")
  mfaEnabledAt DateTime? @map("mfa_enabled_at")

  // Flexible metadata (DB-006 – avoid schema bloat)
  metadata Json @default("{}")

  // Audit fields (DB-004)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Two DB-only partial unique indexes protect active-row identity and are
/// NOT representable in Prisma's schema DSL (Postgres `WHERE` predicate),
/// so they exist only in migration SQL, not as `@@unique` here:
///   opportunities_candidate_active_key
///     ON (workspace_id, marketplace_product_candidate_id)
///     WHERE deleted_at IS NULL AND marketplace_product_candidate_id IS NOT NULL
///   opportunities_manual_active_key
///     ON (workspace_id, normalized_keyword, marketplace, country)
///     WHERE deleted_at IS NULL AND marketplace_product_candidate_id IS NULL
model Opportunity {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  keyword     String
  /// trim+lowercase(keyword) — the manual-dedup key; keyword itself keeps
  /// user-entered casing for display.
  normalizedKeyword String? @map("normalized_keyword")
  marketplace String
  country     String @default("US")
  category    String?

  /// Present only when this Opportunity was created by promoting a
  /// MarketplaceProductCandidate; null for manual/legacy keyword-only rows.
  marketplaceProductCandidateId String? @map("marketplace_product_candidate_id")

  // AI-generated scores (0–100, nullable until AI processes the record)
  demandScore      Float? @map("demand_score")
  competitionScore Float? @map("competition_score")
  supplierScore    Float? @map("supplier_score")
  profitScore      Float? @map("profit_score")
  aiScore          Float? @map("ai_score")
  finalScore       Float? @map("final_score")

  recommendation String?
  status         OpportunityStatus @default(DISCOVERED)
  notes          String?

  // Audit fields (DB-004)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  workspace                   Workspace                     @relation(fields: [workspaceId], references: [id])
  marketplaceProductCandidate MarketplaceProductCandidate?  @relation(fields: [marketplaceProductCandidateId], references: [id])

  @@index([workspaceId])
  @@index([status])
  @@index([marketplace])
  @@index([finalScore])
  @@index([deletedAt])
  @@index([marketplaceProductCandidateId])
  @@index([normalizedKeyword])
  @@map("opportunities")
}

model DiscoverySession {
  id                String                 @id @default(uuid())
  workspaceId       String                 @map("workspace_id")
  marketplace       String
  country           String                 @default("US")
  categories        Json                   @default("[]")
  keywords          Json                   @default("[]")
  mode              DiscoveryMode          @default(KEYWORD)
  /// Cold-start seed category (TREND_COLD_START mode only) — no provider
  /// populates this yet; schema slot for a future prompt.
  seedCategoryId    String?                @map("seed_category_id")
  status            DiscoverySessionStatus @default(PENDING)
  totalDiscovered   Int                    @default(0) @map("total_discovered")
  /// Legacy column name, semantics migrated: counts newly discovered
  /// MarketplaceProductCandidate rows, not Opportunity rows — Discovery no
  /// longer auto-creates Opportunity. Not renamed to avoid churn on a
  /// working, already-consumed column.
  newOpportunities  Int                    @default(0) @map("new_opportunities")
  duplicatesSkipped Int                    @default(0) @map("duplicates_skipped")
  errorMessage      String?                @map("error_message")
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")

  // Audit fields (DB-004)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace         @relation(fields: [workspaceId], references: [id])
  seedCategory Category?         @relation(fields: [seedCategoryId], references: [id])
  results      DiscoveryResult[]

  @@index([workspaceId])
  @@index([status])
  @@index([marketplace])
  @@index([createdAt])
  @@index([mode])
  @@map("discovery_sessions")
}

model DiscoveryResult {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  /// Legacy — Discovery no longer creates Opportunity rows, so this is
  /// null on every row written going forward. Kept for historical rows.
  opportunityId String?  @map("opportunity_id")
  /// Set when the discovered product had a stable external product ID and
  /// a MarketplaceProductCandidate could be upserted for it.
  marketplaceProductCandidateId String? @map("marketplace_product_candidate_id")
  keyword       String
  marketplace   String
  country       String   @default("US")
  category      String?
  isDuplicate   Boolean  @default(false) @map("is_duplicate")
  rank          Int?
  rawData       Json     @default("{}") @map("raw_data")

  // Audit fields (DB-004)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  session                     DiscoverySession              @relation(fields: [sessionId], references: [id])
  marketplaceProductCandidate MarketplaceProductCandidate?  @relation(fields: [marketplaceProductCandidateId], references: [id])

  @@index([sessionId])
  @@index([keyword])
  @@index([isDuplicate])
  @@index([marketplace])
  @@index([marketplaceProductCandidateId])
  @@map("discovery_results")
}

// =============================================================
// PRODUCT DISCOVERY DOMAIN FOUNDATION (marketplace-neutral)
// =============================================================

/// Generic, provider-agnostic taxonomy node. Not tied to any marketplace —
/// MarketplaceCategoryMapping links a marketplace's own category tree into
/// this generic tree; Amazon's and Flipkart's trees are never assumed
/// identical, they each map in independently (many marketplace nodes can
/// point at one generic Category).
model Category {
  id       String  @id @default(uuid())
  parentId String? @map("parent_id")
  name     String
  slug     String
  /// Free string, not an enum, so a new taxonomy source never needs a
  /// migration: e.g. "SEED", "WIKIPEDIA", "MARKETPLACE_IMPORT", "MANUAL".
  source   String  @default("MANUAL")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent            Category?                    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]                   @relation("CategoryHierarchy")
  productConcepts   ProductConcept[]
  categoryMappings  MarketplaceCategoryMapping[]
  discoverySessions DiscoverySession[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([source])
  @@map("categories")
}

/// A marketplace-neutral product idea — not yet validated against any
/// marketplace. Global/shared (not workspace-scoped): it is an idea, not a
/// workspace decision.
model ProductConcept {
  id             String @id @default(uuid())
  categoryId     String? @map("category_id")
  name           String
  /// trim+lowercase(name) — canonical identity, see Prompt 3 §5.A.
  normalizedName String  @map("normalized_name")
  /// Free string: "TREND_DISCOVERY", "MANUAL", "KEYWORD_SEARCH".
  createdFrom    String  @default("MANUAL") @map("created_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   Category?                     @relation(fields: [categoryId], references: [id])
  candidates MarketplaceProductCandidate[]

  @@unique([categoryId, normalizedName])
  @@index([normalizedName])
  @@map("product_concepts")
}

/// Generic, provider-agnostic evidence record. Polymorphic subject
/// (subjectType/subjectId) deliberately has NO Prisma `@relation`/FK —
/// Postgres can't enforce a foreign key against two different target
/// tables, so referential integrity for this pointer is an application-
/// layer responsibility, a standard trade-off for polymorphic associations.
/// `source` stays a free string (never an enum) so a new provider (e.g.
/// Wikipedia, Keepa, Google Trends) never requires a schema migration.
model TrendSignal {
  id             String                     @id @default(uuid())
  subjectType    TrendSignalSubjectType     @map("subject_type")
  subjectId      String                     @map("subject_id")
  /// Free string bucket, e.g. "ATTENTION", "SEARCH_DEMAND", "GROWTH",
  /// "MARKETPLACE_RANK", "PRICE", "COMPETITION", "SUPPLIER_AVAILABILITY".
  signalType     String                     @map("signal_type")
  source         String
  classification TrendSignalClassification
  value          Float?
  unit           String?
  /// Untouched provider response, for RAW_PROVIDER rows.
  rawPayload      Json?    @map("raw_payload")
  /// Plain-language summary, for AI_EXPLANATION rows only — must reference
  /// real RAW_PROVIDER/ATLAS_DERIVED rows, never invent a value.
  explanationText String?  @map("explanation_text")
  capturedAt      DateTime @map("captured_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@index([signalType])
  @@index([source])
  @@index([capturedAt])
  @@map("trend_signals")
}

/// A specific real product on a specific marketplace. Global/shared (not
/// workspace-scoped) — the same ASIN rediscovered by any workspace or any
/// discovery run resolves to this same row via the unique constraint below.
/// Canonical identity is the marketplace's own native external ID — never
/// a keyword (Case 11).
model MarketplaceProductCandidate {
  id                  String  @id @default(uuid())
  marketplaceKey      String  @map("marketplace_key")
  country             String
  /// The marketplace's own native product ID — ASIN for Amazon, FSN for
  /// Flipkart, etc. Mandatory: if an adapter can't return a stable ID, no
  /// candidate row is created for that result at all (Prompt 3 §5.B).
  externalProductId   String  @map("external_product_id")
  productConceptId    String? @map("product_concept_id")
  title               String?
  marketplaceCategory String? @map("marketplace_category")

  discoveredAt DateTime @default(now()) @map("discovered_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  productConcept   ProductConcept?       @relation(fields: [productConceptId], references: [id])
  snapshots        MarketplaceSnapshot[]
  opportunities    Opportunity[]
  discoveryResults DiscoveryResult[]

  @@unique([marketplaceKey, country, externalProductId])
  @@index([productConceptId])
  @@map("marketplace_product_candidates")
}

/// One poll of a candidate's live marketplace metrics. Rank/price/offer
/// count are stored together because a real marketplace call typically
/// returns them together — a deliberate efficiency merge over one
/// polymorphic TrendSignal row per metric, not a new concept.
model MarketplaceSnapshot {
  id          String   @id @default(uuid())
  candidateId String   @map("candidate_id")
  salesRank   Int?     @map("sales_rank")
  price       Float?
  offerCount  Int?     @map("offer_count")
  source      String
  capturedAt  DateTime @map("captured_at")

  createdAt DateTime @default(now()) @map("created_at")

  candidate MarketplaceProductCandidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId])
  @@index([capturedAt])
  @@map("marketplace_snapshots")
}

// =============================================================
// SUPPLIER DISCOVERY ENGINE
// =============================================================

model Supplier {
  id                 String                 @id @default(uuid())
  workspaceId        String                 @map("workspace_id")
  name               String
  provider           SupplierSourceProvider @default(MANUAL)
  providerSupplierId String?                @map("provider_supplier_id")
  country            String                 @default("IN")
  city               String?
  website            String?
  contactEmail       String?                @map("contact_email")
  contactPhone       String?                @map("contact_phone")
  tier               SupplierTier           @default(UNVERIFIED)
  status             SupplierStatus         @default(PENDING_REVIEW)

  // ── Management fields ─────────────────────────────────────────
  legalName            String?                  @map("legal_name")
  managementStatus     SupplierManagementStatus @default(PROSPECT) @map("management_status")

  // Rich profile stored as JSON (avoids schema migrations for new fields)
  addresses            Json?  @default("[]")
  contactPersons       Json?  @default("[]") @map("contact_persons")
  businessRegistration Json?  @map("business_registration")
  taxIdentifiers       Json?  @default("[]") @map("tax_identifiers")
  paymentTerms         Json?  @map("payment_terms")
  shippingTerms        Json?  @map("shipping_terms")
  certifications       Json?  @default("[]")
  tags                 Json?  @default("[]")

  // Scores
  verificationScore  Float?  @map("verification_score")
  verificationStatus String? @map("verification_status")
  riskScore          Float?  @map("risk_score")
  performanceScore   Float?  @map("performance_score")

  categories         Json                   @default("[]")
  minOrderQuantity   Int?                   @map("min_order_quantity")
  avgLeadTimeDays    Int?                   @map("avg_lead_time_days")
  overallRating      Float?                 @map("overall_rating")
  notes              String?
  rawData            Json                   @default("{}") @map("raw_data")

  // Audit fields (DB-004)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id])
  opportunityLinks OpportunitySupplier[]
  discoveryResults SupplierDiscoveryResult[]
  verifications    SupplierVerification[]
  statusHistory    SupplierStatusHistory[]
  profileHistory   SupplierProfileHistory[]
  providerIdentities SupplierProviderIdentity[]

  @@unique([workspaceId, provider, providerSupplierId])
  @@index([workspaceId])
  @@index([provider])
  @@index([status])
  @@index([managementStatus])
  @@index([tier])
  @@index([country])
  @@index([deletedAt])
  @@map("suppliers")
}

model SupplierStatusHistory {
  id             String  @id @default(uuid())
  supplierId     String  @map("supplier_id")
  workspaceId    String  @map("workspace_id")
  previousStatus String? @map("previous_status")
  newStatus      String  @map("new_status")
  reason         String?
  changedBy      String? @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("supplier_status_history")
}

model SupplierProfileHistory {
  id          String  @id @default(uuid())
  supplierId  String  @map("supplier_id")
  workspaceId String  @map("workspace_id")
  snapshot    Json    @default("{}")
  changedBy   String? @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([workspaceId])
  @@map("supplier_profile_history")
}

model SupplierProviderIdentity {
  id                 String    @id @default(cuid())
  supplierId         String    @map("supplier_id")
  workspaceId        String    @map("workspace_id")
  providerCode       String    @map("provider_code")
  providerSupplierId String    @map("provider_supplier_id")
  providerUrl        String?   @map("provider_url")
  syncedAt           DateTime? @map("synced_at")
  rawData            Json      @default("{}") @map("raw_data")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, providerCode])
  @@unique([workspaceId, providerCode, providerSupplierId])
  @@index([supplierId])
  @@index([workspaceId])
  @@index([providerCode])
  @@map("supplier_provider_identities")
}

model OpportunitySupplier {
  id            String   @id @default(uuid())
  opportunityId String   @map("opportunity_id")
  supplierId    String   @map("supplier_id")
