  configurationId         String                @map("configuration_id")
  
  status                  WarehouseSyncStatus   @default(PENDING)
  
  sourceWarehouseId       String                @map("source_warehouse_id")
  targetWarehouseId       String                @map("target_warehouse_id")
  
  syncType                WarehouseSyncType     @map("sync_type")
  syncDirection           WarehouseSyncDirection @map("sync_direction")
  
  totalItems              Int                   @default(0) @map("total_items")
  processedItems          Int                   @default(0) @map("processed_items")
  successItems            Int                   @default(0) @map("success_items")
  failedItems             Int                   @default(0) @map("failed_items")
  conflictItems           Int                   @default(0) @map("conflict_items")
  
  cursor                  String?
  lastSyncVersion         String?               @map("last_sync_version")
  
  startedAt               DateTime?             @map("started_at")
  completedAt             DateTime?             @map("completed_at")
  pausedAt                DateTime?             @map("paused_at")
  cancelledAt             DateTime?             @map("cancelled_at")
  
  errorMessage            String?               @map("error_message")
  errorDetails            Json?                 @map("error_details")
  
  progressPercentage      Float                 @default(0) @map("progress_percentage")
  
  idempotencyKey          String?               @unique @map("idempotency_key")
  
  metadata                Json                  @default("{}")
  
  triggeredBy             String?               @map("triggered_by")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  
