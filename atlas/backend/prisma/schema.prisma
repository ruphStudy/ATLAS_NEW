  history                 WarehouseSyncHistory[]
  conflicts               WarehouseSyncConflict[]
  
  @@unique([workspaceId, jobNumber])
  @@index([workspaceId])
  @@index([configurationId])
  @@index([status])
  @@index([sourceWarehouseId])
  @@index([targetWarehouseId])
  @@index([createdAt])
  @@map("warehouse_sync_jobs")
}

model WarehouseSyncHistory {
  id                  String              @id @default(uuid())
  syncJobId           String              @map("sync_job_id")
  workspaceId         String              @map("workspace_id")
  fromStatus          WarehouseSyncStatus? @map("from_status")
  toStatus            WarehouseSyncStatus  @map("to_status")
  reason              String?
  changedBy           String?             @map("changed_by")
  snapshot            Json?
  createdAt           DateTime            @default(now()) @map("created_at")
  
  syncJob             WarehouseSyncJob    @relation(fields: [syncJobId], references: [id])
  
  @@index([syncJobId])
  @@index([workspaceId])
  @@map("warehouse_sync_history")
}

model WarehouseSyncConflict {
  id                  String                         @id @default(uuid())
  syncJobId           String                         @map("sync_job_id")
  workspaceId         String                         @map("workspace_id")
  
  inventoryItemId     String                         @map("inventory_item_id")
  sku                 String?
  
  sourceWarehouseId   String                         @map("source_warehouse_id")
  targetWarehouseId   String                         @map("target_warehouse_id")
  
  sourceQuantity      Float                          @map("source_quantity")
  targetQuantity      Float                          @map("target_quantity")
  
  sourceVersion       String?                        @map("source_version")
  targetVersion       String?                        @map("target_version")
  
  sourceUpdatedAt     DateTime?                      @map("source_updated_at")
  targetUpdatedAt     DateTime?                      @map("target_updated_at")
  
  conflictType        String                         @map("conflict_type")
  conflictReason      String?                        @map("conflict_reason")
  
  conflictStrategy    WarehouseSyncConflictStrategy  @map("conflict_strategy")
  
  resolved            Boolean                        @default(false)
  resolvedAt          DateTime?                      @map("resolved_at")
  resolvedBy          String?                        @map("resolved_by")
  resolutionAction    String?                        @map("resolution_action")
  resolutionNotes     String?                        @map("resolution_notes")
  
  sourceData          Json?                          @map("source_data")
  targetData          Json?                          @map("target_data")
  
  metadata            Json                           @default("{}")
  
  createdAt           DateTime                       @default(now()) @map("created_at")
  
  syncJob             WarehouseSyncJob               @relation(fields: [syncJobId], references: [id])
  
  @@index([syncJobId])
  @@index([workspaceId])
  @@index([inventoryItemId])
  @@index([resolved])
  @@map("warehouse_sync_conflicts")
}

