  syncDirection           WarehouseSyncDirection         @default(UNIDIRECTIONAL) @map("sync_direction")
  
  conflictStrategy        WarehouseSyncConflictStrategy  @default(LATEST_WINS) @map("conflict_strategy")
  
  syncAvailable           Boolean                        @default(true) @map("sync_available")
  syncReserved            Boolean                        @default(true) @map("sync_reserved")
  syncAllocated           Boolean                        @default(true) @map("sync_allocated")
  syncBlocked             Boolean                        @default(false) @map("sync_blocked")
  syncDamaged             Boolean                        @default(false) @map("sync_damaged")
  syncInTransit           Boolean                        @default(true) @map("sync_in_transit")
  syncIncoming            Boolean                        @default(true) @map("sync_incoming")
  
