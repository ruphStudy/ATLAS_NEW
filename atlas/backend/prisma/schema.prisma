  DISABLED
  ARCHIVED
}

enum FeatureFlagOverrideStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum FeatureFlagHistoryEntityType {
  DEFINITION
  OVERRIDE
}

enum FeatureFlagChangeType {
  DEFINITION_CREATED
  DEFINITION_UPDATED
  DEFINITION_ENABLED
  DEFINITION_DISABLED
  DEFINITION_ARCHIVED
  DEFINITION_RESTORED
  KILL_SWITCH_ACTIVATED
  KILL_SWITCH_DEACTIVATED
  OVERRIDE_CREATED
