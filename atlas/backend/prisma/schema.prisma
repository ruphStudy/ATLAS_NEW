model InventoryItem {
  id               String                @id @default(uuid())
  workspaceId      String                @map("workspace_id")
  sku              String
  skuSequence      Int                   @map("sku_sequence")
  catalogProductId String?               @map("catalog_product_id")
  variantId        String?               @map("variant_id")
  name             String
  status           InventoryItemStatus   @default(DRAFT)
  trackingType     InventoryTrackingType @default(NONE) @map("tracking_type")

  baseUom         String  @default("EA") @map("base_uom")
  reorderPoint    Int     @default(0) @map("reorder_point")
  safetyStock     Int     @default(0) @map("safety_stock")
  reorderQuantity Int     @default(0) @map("reorder_quantity")
  isExpiryTracked Boolean @default(false) @map("is_expiry_tracked")
  shelfLifeDays   Int?    @map("shelf_life_days")

  version  Int  @default(1)
  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace       Workspace                 @relation(fields: [workspaceId], references: [id])
  unitConversions InventoryUnitConversion[]
  batches         InventoryBatch[]
  serials         InventorySerial[]
  stocks          InventoryStock[]
  transactions    InventoryTransaction[]
  history         InventoryItemHistory[]
  config          InventoryConfig?
  reservations    InventoryReservation[]
  allocations     InventoryAllocation[]
  adjustments     InventoryAdjustment[]
  reconciliationRuns  InventoryReconciliationRun[]
  reconciliationLines InventoryReconciliationLine[]
  cycleCounts         InventoryCycleCount[]
  cycleCountLines     InventoryCycleCountLine[]
  movements           InventoryMovement[]
  transferLines       InventoryTransferLine[]

  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@index([catalogProductId])
  @@index([catalogProductId, variantId])
  @@index([status])
  @@index([deletedAt])
  @@map("inventory_items")
}

model InventoryItemHistory {
  id              String              @id @default(uuid())
  inventoryItemId String              @map("inventory_item_id")
  workspaceId     String              @map("workspace_id")
  fromStatus      InventoryItemStatus @map("from_status")
  toStatus        InventoryItemStatus @map("to_status")
  version         Int
  reason          String?
  changedBy       String?             @map("changed_by")
  snapshot        Json?
  createdAt       DateTime            @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([workspaceId])
  @@map("inventory_item_history")
}

model InventoryUnitConversion {
  id               String  @id @default(uuid())
  inventoryItemId  String  @map("inventory_item_id")
  workspaceId      String  @map("workspace_id")
  fromUom          String  @map("from_uom")
