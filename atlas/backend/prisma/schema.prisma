// ═══════════════════════════════════════════════════════════════════════════
// AI Fallback & Retry Management
// ═══════════════════════════════════════════════════════════════════════════

enum AiRetryStatus {
  PENDING
  RETRYING
  SUCCEEDED
  FAILED
  EXHAUSTED
  CANCELLED
}

enum AiFailureType {
  PROVIDER_ERROR
  MODEL_ERROR
  TIMEOUT
  RATE_LIMIT
  VALIDATION_ERROR
  SAFETY_ERROR
  UNAUTHORIZED
  BUDGET_EXCEEDED
  QUOTA_EXCEEDED
  CIRCUIT_OPEN
  NETWORK_ERROR
  UNKNOWN
}

enum AiBackoffStrategy {
  FIXED
  LINEAR
  EXPONENTIAL
  EXPONENTIAL_JITTER
}

model AiRetryPolicy {
  id                      String              @id @default(uuid())
  workspaceId             String?             @map("workspace_id")

  name                    String
  capability              String?
  useCase                 String?             @map("use_case")
  modelProvider           String?             @map("model_provider")

  maxRetries              Int                 @default(3) @map("max_retries")
  initialDelayMs          Int                 @default(1000) @map("initial_delay_ms")
  maxDelayMs              Int                 @default(60000) @map("max_delay_ms")
  backoffMultiplier       Float               @default(2.0) @map("backoff_multiplier")
  backoffStrategy         AiBackoffStrategy   @default(EXPONENTIAL) @map("backoff_strategy")
  jitterFactor            Float               @default(0.1) @map("jitter_factor")

  timeoutMs               Int?                @map("timeout_ms")

  retryableFailures       String[]            @default([]) @map("retryable_failures")
  nonRetryableFailures    String[]            @default([]) @map("non_retryable_failures")

  enableFallback          Boolean             @default(true) @map("enable_fallback")
  fallbackPriority        Int                 @default(0) @map("fallback_priority")

  respectBudget           Boolean             @default(true) @map("respect_budget")
  respectQuota            Boolean             @default(true) @map("respect_quota")
  respectCircuitBreaker   Boolean             @default(true) @map("respect_circuit_breaker")

  enabled                 Boolean             @default(true)
  priority                Int                 @default(0)

  tags                    String[]            @default([])
  metadata                Json                @default("{}")

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  deletedAt               DateTime?           @map("deleted_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([capability])
  @@index([modelProvider])
  @@index([enabled])
  @@index([deletedAt])
  @@map("ai_retry_policies")
}

model AiRetryExecution {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  status                  AiRetryStatus       @default(PENDING)
  
  orchestratorRequestId   String?             @map("orchestrator_request_id")
  agentExecutionId        String?             @map("agent_execution_id")
  workflowExecutionId     String?             @map("workflow_execution_id")

  capability              String
  useCase                 String?             @map("use_case")

  originalProvider        String              @map("original_provider")
  originalModel           String              @map("original_model")

  policyId                String?             @map("policy_id")
  policySnapshot          Json?               @map("policy_snapshot")

  requestPayload          Json                @map("request_payload")
  requestContext          Json                @default("{}") @map("request_context")

  currentAttempt          Int                 @default(0) @map("current_attempt")
  maxAttempts             Int                 @map("max_attempts")

  lastFailureType         AiFailureType?      @map("last_failure_type")
  lastFailureMessage      String?             @map("last_failure_message")
  lastFailureCode         String?             @map("last_failure_code")

  finalProvider           String?             @map("final_provider")
  finalModel              String?             @map("final_model")
  finalResponse           Json?               @map("final_response")

  totalTokensUsed         Int                 @default(0) @map("total_tokens_used")
  totalCost               Float               @default(0) @map("total_cost")

  idempotencyKey          String?             @unique @map("idempotency_key")

  startTime               DateTime?           @map("start_time")
  endTime                 DateTime?           @map("end_time")
  totalDuration           Int?                @map("total_duration")

  tags                    String[]            @default([])
  metadata                Json                @default("{}")

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  attempts                AiRetryAttempt[]
  fallbacks               AiFallbackExecution[]

  @@index([workspaceId])
  @@index([status])
  @@index([orchestratorRequestId])
  @@index([agentExecutionId])
  @@index([workflowExecutionId])
  @@index([capability])
  @@index([originalProvider])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("ai_retry_executions")
}

model AiRetryAttempt {
  id                      String              @id @default(uuid())
  retryExecutionId        String              @map("retry_execution_id")
  workspaceId             String              @map("workspace_id")

  attemptNumber           Int                 @map("attempt_number")

  provider                String
  model                   String

  succeeded               Boolean             @default(false)
  
  failureType             AiFailureType?      @map("failure_type")
  failureMessage          String?             @map("failure_message")
  failureCode             String?             @map("failure_code")
