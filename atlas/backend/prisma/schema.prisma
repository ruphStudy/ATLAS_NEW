model InventoryStock {
  id              String                 @id @default(uuid())
  workspaceId     String                 @map("workspace_id")
  inventoryItemId String                 @map("inventory_item_id")
  warehouseId     String                 @map("warehouse_id")
  locationId      String?                @map("location_id")
  binId           String?                @map("bin_id")
  batchId         String?                @map("batch_id")
  status          InventoryStockStatus   @default(AVAILABLE)
  ownershipType   InventoryOwnershipType @default(WORKSPACE) @map("ownership_type")
  ownerRef        String?                @map("owner_ref")
  quantity        Float                  @default(0)
  uom             String                 @default("EA")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  location      WarehouseLocation? @relation(fields: [locationId], references: [id])
  bin           WarehouseBin?      @relation(fields: [binId], references: [id])
  batch         InventoryBatch?    @relation(fields: [batchId], references: [id])

  @@unique([inventoryItemId, warehouseId, locationId, binId, batchId, status, ownershipType, ownerRef], name: "unique_stock_bucket")
  @@index([workspaceId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([binId])
  @@index([status])
  @@map("inventory_stocks")
}

model InventoryTransaction {
  id                String                     @id @default(uuid())
  workspaceId       String                     @map("workspace_id")
  inventoryItemId   String                     @map("inventory_item_id")
  sku               String?
  catalogProductId  String?                    @map("catalog_product_id")
  variantId         String?                    @map("variant_id")
  warehouseId       String?                    @map("warehouse_id")
  locationId        String?                    @map("location_id")
  batchId           String?                    @map("batch_id")
  serialId          String?                    @map("serial_id")
  ownershipType     InventoryOwnershipType     @default(WORKSPACE) @map("ownership_type")
  ownerRef          String?                    @map("owner_ref")
  type              InventoryTransactionType
  status            InventoryTransactionStatus @default(POSTED)
  quantity          Float                      @default(0)
  quantityBefore    Float?                     @map("quantity_before")
  quantityAfter     Float?                     @map("quantity_after")
  uom               String                     @default("EA")
  fromStatus        InventoryStockStatus?      @map("from_status")
  toStatus          InventoryStockStatus?      @map("to_status")
  referenceType     String?                    @map("reference_type")
  referenceId       String?                    @map("reference_id")
  externalReference String?                    @map("external_reference")
  idempotencyKey    String?                    @map("idempotency_key")
  reason            String?
  performedBy       String?                    @map("performed_by")
  metadata          Json?

  reversalOfId String?   @map("reversal_of_id")
  reversedAt   DateTime? @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem          @relation(fields: [inventoryItemId], references: [id])
  reversalOf    InventoryTransaction?  @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversals     InventoryTransaction[] @relation("TransactionReversal")

  @@unique([workspaceId, idempotencyKey], name: "unique_transaction_idempotency")
  @@index([workspaceId])
  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@index([sku])
  @@index([reversalOfId])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model InventoryConfig {
  id                      String  @id @default(uuid())
  workspaceId             String  @map("workspace_id")
  inventoryItemId         String  @unique @map("inventory_item_id")
  valuationMethod         String  @default("FIFO") @map("valuation_method")
