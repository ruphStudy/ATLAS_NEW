  PENDING_TRANSFORMATION
  TRANSFORMING
  TRANSFORMED
  VALIDATED
  VALIDATION_FAILED
  READY
  PUBLISHED
  FAILED
  ARCHIVED
}

// =============================================================
// PRICING ENGINE – MODELS
// =============================================================

model PricingConfig {
  id              String          @id @default(cuid())
  workspaceId     String          @map("workspace_id")
  marketplaceKey  String          @map("marketplace_key")
  country         String          @default("GLOBAL")
  currency        String          @default("USD")
  strategy        PricingStrategy @default(MARGIN_BASED)
  isDefault       Boolean         @default(false) @map("is_default")
  isActive        Boolean         @default(true) @map("is_active")

  // Fee components (percentages unless noted)
  commissionPct         Float?  @map("commission_pct")
  fulfilmentFeeFlat     Float?  @map("fulfilment_fee_flat")
  shippingFeeFlat       Float?  @map("shipping_fee_flat")
  paymentProcessingPct  Float?  @map("payment_processing_pct")
  packagingCostFlat     Float?  @map("packaging_cost_flat")
  advertisingCostPct    Float?  @map("advertising_cost_pct")
  taxPct                Float?  @map("tax_pct")

  // Target thresholds
  targetMarginPct       Float?  @map("target_margin_pct")
  targetRoi             Float?  @map("target_roi")
  minProfitFlat         Float?  @map("min_profit_flat")
  minMarginPct          Float?  @map("min_margin_pct")

  // Price adjustments
  marketplacePriceAdjustmentPct Float?  @map("marketplace_price_adjustment_pct")
  regionalPriceAdjustmentPct    Float?  @map("regional_price_adjustment_pct")
  currencyConversionRate        Float?  @map("currency_conversion_rate")

  // Flexible rule config
  rules   Json?

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt     @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  pricingRecords PricingRecord[]

  @@index([workspaceId])
  @@index([marketplaceKey])
  @@index([country])
  @@index([isActive])
  @@index([deletedAt])
  @@map("pricing_configs")
}

model PricingRecord {
  id               String          @id @default(cuid())
  workspaceId      String          @map("workspace_id")
  catalogProductId String          @map("catalog_product_id")
  configId         String?         @map("config_id")
  marketplaceKey   String          @map("marketplace_key")
  country          String          @default("GLOBAL")
  currency         String          @default("USD")
  strategy         PricingStrategy
  status           PricingStatus   @default(DRAFT)
  version          Int             @default(1)

  // Input costs
  baseCost         Float?  @map("base_cost")
  landedCost       Float?  @map("landed_cost")
  procurementCost  Float?  @map("procurement_cost")

  // Calculated fee components
  commissionAmount        Float?  @map("commission_amount")
  fulfilmentFeeAmount     Float?  @map("fulfilment_fee_amount")
  shippingFeeAmount       Float?  @map("shipping_fee_amount")
  paymentProcessingAmount Float?  @map("payment_processing_amount")
  packagingCostAmount     Float?  @map("packaging_cost_amount")
  advertisingCostAmount   Float?  @map("advertising_cost_amount")
  taxAmount               Float?  @map("tax_amount")
  promotionalDiscount     Float?  @map("promotional_discount")

  // Pricing outputs
  totalCost              Float?  @map("total_cost")
  suggestedSellingPrice  Float?  @map("suggested_selling_price")
  marketplaceSellingPrice Float? @map("marketplace_selling_price")
  compareAtPrice         Float?  @map("compare_at_price")
  estimatedProfit        Float?  @map("estimated_profit")
  estimatedMarginPct     Float?  @map("estimated_margin_pct")
  estimatedRoi           Float?  @map("estimated_roi")

  // Manual override
  manualOverridePrice Float?    @map("manual_override_price")
  manualOverrideBy    String?   @map("manual_override_by")
  manualOverrideAt    DateTime? @map("manual_override_at")

  // Scheduled price change
  scheduledPrice     Float?    @map("scheduled_price")
  scheduledAt        DateTime? @map("scheduled_at")

  // Validation
  isValid            Boolean   @default(false) @map("is_valid")
  validationErrors   Json?     @map("validation_errors")

  // Metadata
  calculationMeta  Json?     @map("calculation_meta")
  calculationSource String?  @map("calculation_source")

  errorMessage  String?   @map("error_message")
  failedAt      DateTime? @map("failed_at")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt     @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  config     PricingConfig? @relation(fields: [configId], references: [id])
  history    PricingHistory[]

  @@index([workspaceId])
  @@index([catalogProductId])
  @@index([marketplaceKey])
  @@index([status])
  @@index([deletedAt])
  @@map("pricing_records")
}

model PricingHistory {
  id              String        @id @default(cuid())
  pricingRecordId String        @map("pricing_record_id")
  workspaceId     String        @map("workspace_id")
  version         Int
  strategy        PricingStrategy
  status          PricingStatus
  snapshotData    Json          @map("snapshot_data")
  changedBy       String?       @map("changed_by")
  changeNote      String?       @map("change_note")
  createdAt       DateTime      @default(now()) @map("created_at")

  pricingRecord PricingRecord @relation(fields: [pricingRecordId], references: [id])

  @@index([pricingRecordId])
  @@index([workspaceId])
  @@map("pricing_history")
}

// =============================================================
// UNIVERSAL LISTING + MARKETPLACE LISTING
// =============================================================

model UniversalListing {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  catalogProductId String   @map("catalog_product_id")
  version          Int      @default(1)
  status           String   @default("DRAFT")

  // AI source references
  aiDescriptionId String? @map("ai_description_id")
  aiImageSetId    String? @map("ai_image_set_id")
  aiSeoId         String? @map("ai_seo_id")
  templateId      String? @map("template_id")

  // Universal content (marketplace-agnostic)
  content         Json     @default("{}")
  qualityScore    Int?     @map("quality_score")
  validationResult Json?   @map("validation_result")

  // Error
  errorMessage           String?   @map("error_message")
  failedAt               DateTime? @map("failed_at")
  generationStartedAt    DateTime? @map("generation_started_at")
  generationCompletedAt  DateTime? @map("generation_completed_at")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt     @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace          Workspace               @relation(fields: [workspaceId], references: [id])
  history            UniversalListingHistory[]
  marketplaceListings MarketplaceListing[]

  @@index([workspaceId])
  @@index([catalogProductId])
  @@index([status])
  @@index([deletedAt])
  @@map("universal_listings")
}

model UniversalListingHistory {
  id               String   @id @default(cuid())
  universalListingId String @map("universal_listing_id")
  workspaceId      String   @map("workspace_id")
  fromStatus       String   @map("from_status")
  toStatus         String   @map("to_status")
  version          Int
  sectionsUpdated  Json?    @map("sections_updated")
  reason           String?
  changedBy        String?  @map("changed_by")
  snapshotContent  Json?    @map("snapshot_content")
  createdAt        DateTime @default(now()) @map("created_at")

  universalListing UniversalListing @relation(fields: [universalListingId], references: [id])

  @@index([universalListingId])
  @@index([workspaceId])
  @@map("universal_listing_history")
}

model MarketplaceListing {
  id                 String                   @id @default(cuid())
  workspaceId        String                   @map("workspace_id")
  universalListingId String                   @map("universal_listing_id")
  catalogProductId   String                   @map("catalog_product_id")
  marketplaceKey     String                   @map("marketplace_key")
  country            String                   @default("GLOBAL")
  status             MarketplaceListingStatus @default(PENDING_TRANSFORMATION)
  version            Int                      @default(1)

  // Schema reference
  schemaId      String?  @map("schema_id")
  schemaVersion String?  @map("schema_version")

  // Transformed payload
  transformedPayload Json?    @map("transformed_payload")
  fieldTrace         Json?    @map("field_trace")
  warnings           Json?
  errors             Json?

  // Validation
  readinessScore  Int?    @map("readiness_score")
  readinessStatus String? @map("readiness_status")
  validationResult Json?  @map("validation_result")

  // Transformation metadata
  isDryRun           Boolean   @default(false) @map("is_dry_run")
  transformStartedAt DateTime? @map("transform_started_at")
  transformCompletedAt DateTime? @map("transform_completed_at")
  failedAt           DateTime? @map("failed_at")
  errorMessage       String?   @map("error_message")

  // Publishing
  externalListingId String?   @map("external_listing_id")
  publishedAt       DateTime? @map("published_at")

  triggeredBy String?   @map("triggered_by")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt     @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace        Workspace           @relation(fields: [workspaceId], references: [id])
  universalListing UniversalListing    @relation(fields: [universalListingId], references: [id])
  history          MarketplaceListingHistory[]

  @@index([workspaceId])
  @@index([universalListingId])
  @@index([marketplaceKey])
  @@index([status])
  @@index([deletedAt])
  @@map("marketplace_listings")
}

model MarketplaceListingHistory {
  id                   String   @id @default(cuid())
  marketplaceListingId String   @map("marketplace_listing_id")
  workspaceId          String   @map("workspace_id")
  fromStatus           String   @map("from_status")
  toStatus             String   @map("to_status")
  version              Int
  reason               String?
  changedBy            String?  @map("changed_by")
  snapshotPayload      Json?    @map("snapshot_payload")
  createdAt            DateTime @default(now()) @map("created_at")

  marketplaceListing MarketplaceListing @relation(fields: [marketplaceListingId], references: [id])

  @@index([marketplaceListingId])
  @@index([workspaceId])
  @@map("marketplace_listing_history")
}

// =============================================================
// Marketplace Provider Foundation
// =============================================================

model WorkspaceMarketplaceProviderConfig {
  id                     String    @id @default(cuid())
  workspaceId            String    @map("workspace_id")
  providerKey            String    @map("provider_key")
  accountId              String?   @default("") @map("account_id")
  isEnabled              Boolean   @default(true) @map("is_enabled")
  priority               Int       @default(50)
  configuration          Json      @default("{}") @map("configuration")
  encryptedCredentials   String?   @map("encrypted_credentials")
  credentialIv           String?   @map("credential_iv")
  credentialAuthTag      String?   @map("credential_auth_tag")
  credentialType         String?   @map("credential_type")
  credentialExpiresAt    DateTime? @map("credential_expires_at")
  credentialValidatedAt  DateTime? @map("credential_validated_at")
  createdBy              String?   @map("created_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt       @map("updated_at")
  deletedAt              DateTime?                  @map("deleted_at")

  workspace              Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, providerKey, accountId])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([isEnabled])
  @@index([deletedAt])
  @@map("workspace_marketplace_provider_configs")
}

model MarketplaceProviderAccount {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  providerKey   String    @map("provider_key")
  accountHandle String    @map("account_handle")
  displayName   String?   @map("display_name")
  country       String?
  region        String?
  currency      String?
  status        String    @default("PENDING_VERIFICATION")
  isDefault     Boolean   @default(false) @map("is_default")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt       @map("updated_at")
  deletedAt     DateTime?                  @map("deleted_at")

  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, providerKey, accountHandle])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([status])
  @@index([deletedAt])
  @@map("marketplace_provider_accounts")
}

model MarketplaceProviderHealthLog {
  id          String    @id @default(cuid())
  workspaceId String?   @map("workspace_id")
  providerKey String    @map("provider_key")
  accountId   String?   @map("account_id")
  status      String
  latencyMs   Int?      @map("latency_ms")
  message     String?
  details     Json?
  checkedAt   DateTime  @map("checked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([providerKey])
  @@index([workspaceId])
  @@index([checkedAt])
  @@map("marketplace_provider_health_logs")
}

model MarketplaceProviderAuditLog {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  providerKey   String    @map("provider_key")
  accountId     String?   @map("account_id")
  action        String
  capability    String?
  correlationId String    @map("correlation_id")
  success       Boolean
  durationMs    Int       @map("duration_ms")
  errorCode     String?   @map("error_code")
  performedBy   String?   @map("performed_by")
  details       Json?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([providerKey])
  @@index([correlationId])
  @@index([createdAt])
  @@map("marketplace_provider_audit_logs")
}

// =============================================================
// Marketplace Provider Configuration
// =============================================================

model MarketplaceProviderConfigRecord {
  id               String    @id @default(cuid())
  workspaceId      String?   @map("workspace_id")
  scope            String    @default("WORKSPACE")
  providerKey      String    @map("provider_key")
  accountId        String?   @map("account_id")
  name             String
  description      String?
  status           String    @default("DRAFT")
  version          Int       @default(1)
  publishedVersion Int?      @map("published_version")
  effectiveFrom    DateTime? @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  payload          Json      @default("{}")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  approvedBy       String?   @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt       @map("updated_at")
  deletedAt        DateTime?                  @map("deleted_at")

  history          MarketplaceProviderConfigHistory[]

  @@index([providerKey])
  @@index([workspaceId])
  @@index([status])
  @@index([scope])
  @@index([deletedAt])
  @@map("marketplace_provider_config_records")
}

model MarketplaceProviderConfigHistory {
  id          String    @id @default(cuid())
  configId    String    @map("config_id")
  workspaceId String?   @map("workspace_id")
  providerKey String    @map("provider_key")
  version     Int
  status      String
  payload     Json      @default("{}")
  changeReason String?  @map("change_reason")
  changedBy   String?   @map("changed_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  config      MarketplaceProviderConfigRecord @relation(fields: [configId], references: [id])

  @@index([configId])
  @@index([providerKey])
  @@index([workspaceId])
  @@map("marketplace_provider_config_history")
}
