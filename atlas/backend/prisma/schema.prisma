  HEALTHY
  DEGRADED
  UNHEALTHY
  OFFLINE
}

enum PaymentConnectionStatus {
  CONNECTED
  FAILED
  TIMEOUT
  UNKNOWN
}

enum PaymentTransactionType {
  PAYMENT
  AUTHORIZATION
  CAPTURE
  REFUND
  CANCELLATION
}

