/// A concrete, issued license grant. Entitlements are a CACHED snapshot fetched from Plan Management at issue/refresh time (never re-derived) — Plan Management remains the entitlement source of truth. Signing keys are per-license RSA keypairs: `encryptedPrivateKey` never leaves the server (used only to sign tokens); `publicKey` is intentionally NOT secret and is safe to return to callers for offline verification.
model License {
  id             String           @id @default(uuid())
  workspaceId    String?          @map("workspace_id")
  organizationId String?          @map("organization_id")
  scopeType      LicenseScopeType @map("scope_type")
  scopeKey       String           @map("scope_key")

  ownerUserId  String? @map("owner_user_id")
  environment  String?
  deploymentId String? @map("deployment_id")

  type   LicenseType
  status LicenseStatus @default(DRAFT)

  planKey        String  @map("plan_key")
  subscriptionId String? @map("subscription_id")

  entitlementsSnapshot   Json?     @map("entitlements_snapshot")
  entitlementsSnapshotAt DateTime? @map("entitlements_snapshot_at")
  featureFlagKeys        String[]  @map("feature_flag_keys")

  licenseKeyId        String @unique @map("license_key_id")
  encryptedPrivateKey String @db.Text @map("encrypted_private_key")
  publicKey           String @db.Text @map("public_key")

  maxActivations  Int? @map("max_activations")
  activationCount Int  @default(0) @map("activation_count")

  issuedAt          DateTime? @map("issued_at")
  activatedAt       DateTime? @map("activated_at")
  expiresAt         DateTime? @map("expires_at")
  gracePeriodDays   Int       @default(0) @map("grace_period_days")
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at")

  lastValidatedAt      DateTime? @map("last_validated_at")
  lastValidationResult String?   @map("last_validation_result")

  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @db.Text @map("suspended_reason")
  revokedAt       DateTime? @map("revoked_at")
  revokedReason   String?   @db.Text @map("revoked_reason")

  externalReference String? @map("external_reference")
  version            Int     @default(1)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history LicenseHistory[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([status])
  @@index([licenseKeyId])
  @@index([expiresAt])
  @@map("licenses")
}

/// Immutable append-only lifecycle ledger for `License` changes.
model LicenseHistory {
  id        String  @id @default(uuid())
  licenseId String  @map("license_id")
  workspaceId String? @map("workspace_id")

  changeType LicenseChangeType @map("change_type")
  fromStatus LicenseStatus?    @map("from_status")
  toStatus   LicenseStatus?    @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("license_history")
}

