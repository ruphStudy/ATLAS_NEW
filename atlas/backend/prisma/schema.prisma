/// Platform-admin-only metadata about a tenant (workspace) — internal flags and support status. Never duplicates anything Workspace Management already owns (name/status/plan/etc.); this is purely SaaS-Administration-specific annotation layered alongside it.
model TenantAdminProfile {
  id          String   @id @default(uuid())
