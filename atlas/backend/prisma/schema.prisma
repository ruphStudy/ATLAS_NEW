  @@index([retryExecutionId])
  @@index([workspaceId])
  @@index([sourceProvider])
  @@index([fallbackProvider])
  @@index([succeeded])
  @@index([createdAt])
  @@map("ai_fallback_executions")
}

// ═══════════════════════════════════════════════════════════════════════════
// AI Cache Management
// ═══════════════════════════════════════════════════════════════════════════

enum AiCacheScope {
  GLOBAL
  WORKSPACE
  USER
  WORKFLOW
  REQUEST
}

enum AiCacheStrategy {
  EXACT_MATCH
  SEMANTIC
  PARTIAL_RESULT
}

enum AiCacheStatus {
  VALID
  STALE
  EXPIRED
  INVALIDATED
  WARMING
}

enum AiCacheEventType {
  HIT
  MISS
  STORE
  EVICT
  INVALIDATE
  WARM
  BYPASS
  REVALIDATE
}

model AiCacheEntry {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  cacheKey                String              @unique @map("cache_key")
  cacheKeyHash            String              @map("cache_key_hash")

  scope                   AiCacheScope
  strategy                AiCacheStrategy
  status                  AiCacheStatus       @default(VALID)

  capability              String
  useCase                 String?             @map("use_case")
  provider                String
  model                   String
  promptVersion           String?             @map("prompt_version")

  userId                  String?             @map("user_id")
  workflowId              String?             @map("workflow_id")
  requestId               String?             @map("request_id")

  inputHash               String              @map("input_hash")
  inputData               Json                @map("input_data")
  contextHash             String?             @map("context_hash")
  contextData             Json?               @map("context_data")
  parametersHash          String?             @map("parameters_hash")
  parameters              Json?

  response                Json
  responseMetadata        Json?               @map("response_metadata")
  
  tokensUsed              Int                 @map("tokens_used")
  cost                    Float
  latencyMs               Int                 @map("latency_ms")

  hitCount                Int                 @default(0) @map("hit_count")
  lastHitAt               DateTime?           @map("last_hit_at")

  ttlSeconds              Int                 @map("ttl_seconds")
  expiresAt               DateTime            @map("expires_at")
  staleAt                 DateTime?           @map("stale_at")

  policyId                String?             @map("policy_id")
  policySnapshot          Json?               @map("policy_snapshot")

  sensitiveData           Boolean             @default(false) @map("sensitive_data")
  bypassable              Boolean             @default(true)

  invalidationReason      String?             @map("invalidation_reason")
  invalidatedAt           DateTime?           @map("invalidated_at")

  tags                    String[]            @default([])
  metadata                Json                @default("{}")

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  policy                  AiCachePolicy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)
  metrics                 AiCacheMetrics[]

  @@index([workspaceId])
  @@index([cacheKeyHash])
  @@index([scope])
  @@index([status])
  @@index([capability])
  @@index([provider, model])
  @@index([userId])
  @@index([workflowId])
  @@index([expiresAt])
  @@index([staleAt])
  @@index([createdAt])
  @@index([hitCount])
  @@index([sensitiveData])
  @@map("ai_cache_entries")
}

model AiCachePolicy {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  name                    String
  description             String?

  scope                   AiCacheScope
  strategy                AiCacheStrategy

  capability              String?
  useCase                 String?             @map("use_case")
  provider                String?
  model                   String?

  enabled                 Boolean             @default(true)
  priority                Int                 @default(0)

  ttlSeconds              Int                 @map("ttl_seconds")
  staleTtlSeconds         Int?                @map("stale_ttl_seconds")

  enableSemanticCache     Boolean             @default(false) @map("enable_semantic_cache")
  semanticThreshold       Float?              @map("semantic_threshold")

  enablePartialCache      Boolean             @default(false) @map("enable_partial_cache")

  enableStaleRevalidate   Boolean             @default(false) @map("enable_stale_revalidate")
  revalidateAsync         Boolean             @default(true) @map("revalidate_async")

  enableWarmup            Boolean             @default(false) @map("enable_warmup")
  warmupSchedule          String?             @map("warmup_schedule")

  bypassOnError           Boolean             @default(true) @map("bypass_on_error")
  bypassOnSensitive       Boolean             @default(true) @map("bypass_on_sensitive")

  invalidateOnPromptChange Boolean            @default(true) @map("invalidate_on_prompt_change")
  invalidateOnModelChange  Boolean            @default(true) @map("invalidate_on_model_change")
  invalidateOnProviderChange Boolean          @default(false) @map("invalidate_on_provider_change")
  invalidateOnConfigChange Boolean            @default(false) @map("invalidate_on_config_change")
  invalidateOnDataChange   Boolean            @default(false) @map("invalidate_on_data_change")

  maxCacheSize            Int?                @map("max_cache_size")
  evictionStrategy        String?             @map("eviction_strategy")

  tags                    String[]            @default([])
  metadata                Json                @default("{}")

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  deletedAt               DateTime?           @map("deleted_at")

  entries                 AiCacheEntry[]
  invalidations           AiCacheInvalidation[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([scope])
  @@index([capability])
  @@index([provider, model])
  @@index([enabled])
  @@index([priority])
  @@index([deletedAt])
  @@map("ai_cache_policies")
}

model AiCacheMetrics {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  cacheEntryId            String?             @map("cache_entry_id")
  policyId                String?             @map("policy_id")

  eventType               AiCacheEventType    @map("event_type")

  capability              String?
  useCase                 String?             @map("use_case")
  provider                String?
  model                   String?

  scope                   AiCacheScope?
  strategy                AiCacheStrategy?

  userId                  String?             @map("user_id")
  workflowId              String?             @map("workflow_id")

  tokensSaved             Int?                @map("tokens_saved")
  costSaved               Float?              @map("cost_saved")
  latencySavedMs          Int?                @map("latency_saved_ms")

  requestLatencyMs        Int?                @map("request_latency_ms")

  metadata                Json                @default("{}")
  timestamp               DateTime            @default(now())

  cacheEntry              AiCacheEntry?       @relation(fields: [cacheEntryId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([cacheEntryId])
  @@index([policyId])
  @@index([eventType])
  @@index([capability])
  @@index([provider, model])
  @@index([userId])
  @@index([workflowId])
  @@index([timestamp])
  @@map("ai_cache_metrics")
}

model AiCacheInvalidation {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  policyId                String?             @map("policy_id")

  reason                  String
  triggerType             String              @map("trigger_type")
  triggerSource           String?             @map("trigger_source")

  scope                   AiCacheScope?
  capability              String?
  useCase                 String?             @map("use_case")
  provider                String?
  model                   String?
  promptVersion           String?             @map("prompt_version")

  entriesInvalidated      Int                 @default(0) @map("entries_invalidated")
  executionTimeMs         Int?                @map("execution_time_ms")

  metadata                Json                @default("{}")
  timestamp               DateTime            @default(now())

  policy                  AiCachePolicy?      @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([policyId])
  @@index([triggerType])
  @@index([capability])
  @@index([provider, model])
  @@index([timestamp])
  @@map("ai_cache_invalidations")
}

