}

model AiFallbackExecution {
  id                      String              @id @default(uuid())
  retryExecutionId        String              @map("retry_execution_id")
  workspaceId             String              @map("workspace_id")

  configId                String?             @map("config_id")

  sourceProvider          String              @map("source_provider")
  sourceModel             String              @map("source_model")

  fallbackProvider        String              @map("fallback_provider")
