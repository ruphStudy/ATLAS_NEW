  ARCHIVED
}

enum OAuthConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum OAuthAuthorizationRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum OAuthHistoryEntityType {
  CLIENT
  CONNECTION
}

enum OAuthChangeType {
  CLIENT_REGISTERED
  CLIENT_UPDATED
  CLIENT_ENABLED
  CLIENT_DISABLED
  CLIENT_SECRET_ROTATED
  CLIENT_REVOKED
  CLIENT_ARCHIVED
  CONNECTION_AUTHORIZED
  CONNECTION_REFRESHED
  CONNECTION_REVOKED
