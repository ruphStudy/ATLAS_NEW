  OVERRIDE_DISABLED
  OVERRIDE_ARCHIVED
}

/// The flag's identity/schema/dependency graph — global, not tenant-scoped (tenant-specific rollout config lives on `FeatureFlagOverride`). Consumes `PlanManagementService`/`SubscriptionManagementService` for plan-gating rather than re-deriving entitlement data (Plan Management explicitly documents itself as the entitlement source of truth, not an evaluation engine).
model FeatureFlagDefinition {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String? @db.Text

  type   FeatureFlagType
  status FeatureFlagDefinitionStatus @default(DRAFT)

  defaultEnabled    Boolean @default(false) @map("default_enabled")
  rolloutPercentage Int?    @map("rollout_percentage")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  /// Other flag keys that must ALSO resolve enabled for this flag to resolve enabled.
  dependencies String[] @map("dependencies")
  /// Other flag keys that can never be simultaneously enabled with this one — resolved deterministically via `priority` then `key` at evaluation time.
  mutuallyExclusiveWith String[] @map("mutually_exclusive_with")
  /// Lower value wins ties when two mutually-exclusive flags would otherwise both evaluate enabled.
  priority Int @default(0)

  killSwitchEnabled Boolean @default(false) @map("kill_switch_enabled")
  killSwitchReason  String? @db.Text @map("kill_switch_reason")

  owner   String?
  version Int     @default(1)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@index([status])
  @@index([type])
  @@map("feature_flag_definitions")
}

/// Per-scope rollout/targeting configuration overriding a `FeatureFlagDefinition`'s default — the tenant-facing half of the Settings-style Definition+Value split.
model FeatureFlagOverride {
  id      String @id @default(uuid())
  flagKey String @map("flag_key")

  scope    FeatureFlagScopeType @map("scope_type")
  scopeKey String               @map("scope_key")

  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  status FeatureFlagOverrideStatus @default(ACTIVE)

  enabled           Boolean @default(true)
  rolloutPercentage Int?    @map("rollout_percentage")
  /// `IFeatureFlagTargetingRules` — allowlist/denylist subject IDs, planKeys/minTierRank, roles, countries, regions, marketplaces, providers, environments.
  rules Json?

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")

  version   Int     @default(1)
  reason    String? @db.Text
  changedBy String? @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  definition FeatureFlagDefinition @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([flagKey, scopeKey])
  @@index([flagKey])
  @@index([scope])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@map("feature_flag_overrides")
}

/// Polymorphic append-only change ledger spanning BOTH `FeatureFlagDefinition` and `FeatureFlagOverride` (discriminated by entityType) — no FK relation since entityId may reference either parent table.
