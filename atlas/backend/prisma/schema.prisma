// =============================================================
// NOTIFICATION PROVIDER FRAMEWORK
// =============================================================
// Status columns are plain String (not native Prisma enums), matching the
// established ai-provider-registry / ai-provider-credentials convention in
// this codebase — validated in application code against TS enums, so new
// statuses/channels never require a schema migration.

model NotificationProviderRegistryEntry {
  id            String    @id @default(uuid())
  workspaceId   String?   @map("workspace_id")

  providerKey   String    @map("provider_key")
