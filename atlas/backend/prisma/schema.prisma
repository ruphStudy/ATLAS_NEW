/// Registration record for an OAuth client app used to connect ATLAS to an external provider (integrations), NOT ATLAS's own login — `providerKey` is a free-form vocabulary (e.g. 'GOOGLE', 'QUICKBOOKS'), and the authorization/token endpoints are admin-configured rather than hardcoded, so no provider-specific logic lives in this generic module (that belongs in future per-provider adapters).
model OAuthClient {
  id             String         @id @default(uuid())
  workspaceId    String?        @map("workspace_id")
  organizationId String?        @map("organization_id")
  scopeType      OAuthScopeType @map("scope_type")
  scopeKey       String         @map("scope_key")

  name        String
  description String? @db.Text
  providerKey String  @map("provider_key")

  clientId              String @map("client_id")
  encryptedClientSecret String @map("encrypted_client_secret") @db.Text

  redirectUris String[] @map("redirect_uris")
  scopes       String[]
  grantTypes   String[] @map("grant_types")
  environment  String   @default("production")

  authorizationEndpoint String  @db.Text @map("authorization_endpoint")
  tokenEndpoint         String  @db.Text @map("token_endpoint")
  revocationEndpoint    String? @db.Text @map("revocation_endpoint")
  userInfoEndpoint      String? @db.Text @map("user_info_endpoint")

  status OAuthClientStatus @default(ACTIVE)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  connections           OAuthConnection[]
  authorizationRequests OAuthAuthorizationRequest[]

  @@unique([scopeKey, name])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([status])
  @@index([providerKey])
  @@map("oauth_clients")
}

/// An authorized connection instance resulting from a completed OAuth flow (authorization-code or client-credentials) for a specific org/workspace/user/service-account scope. Token fields are AES-256-GCM encrypted "references" — never plaintext.
model OAuthConnection {
  id             String         @id @default(uuid())
  clientId       String         @map("client_id")
  workspaceId    String?        @map("workspace_id")
  organizationId String?        @map("organization_id")
  scopeType      OAuthScopeType @map("scope_type")
  scopeKey       String         @map("scope_key")

  ownerUserId          String? @map("owner_user_id")
  serviceAccountHandle String? @map("service_account_handle")

  providerKey           String  @map("provider_key")
  externalAccountId     String? @map("external_account_id")
  externalAccountLabel  String? @map("external_account_label")

  grantedScopes String[] @map("granted_scopes")
  grantType     String   @map("grant_type")

  status OAuthConnectionStatus @default(CONNECTED)

  encryptedAccessToken  String?   @map("encrypted_access_token") @db.Text
  encryptedRefreshToken String?   @map("encrypted_refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")

  consentedAt         DateTime? @map("consented_at")
  lastRefreshedAt     DateTime? @map("last_refreshed_at")
  lastUsedAt          DateTime? @map("last_used_at")
  lastFailureAt       DateTime? @map("last_failure_at")
  lastFailureReason   String?   @db.Text @map("last_failure_reason")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  revokedAt      DateTime? @map("revoked_at")
  revokedReason  String?   @db.Text @map("revoked_reason")
  disconnectedAt DateTime? @map("disconnected_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, scopeKey, externalAccountId])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([status])
  @@index([clientId])
  @@index([accessTokenExpiresAt])
  @@map("oauth_connections")
}

/// Short-lived CSRF-protection record for the authorization-code flow — one row per redirect, carrying the `state`/`nonce` pair validated on callback. Expires quickly; never becomes an `OAuthConnection` unless the exchange succeeds.
model OAuthAuthorizationRequest {
  id             String         @id @default(uuid())
  clientId       String         @map("client_id")
  workspaceId    String?        @map("workspace_id")
  organizationId String?        @map("organization_id")
  scopeType      OAuthScopeType @map("scope_type")
  scopeKey       String         @map("scope_key")

  initiatedByUserId String? @map("initiated_by_user_id")

  state String @unique
  nonce String

  redirectUri     String   @db.Text @map("redirect_uri")
  requestedScopes String[] @map("requested_scopes")

  status OAuthAuthorizationRequestStatus @default(PENDING)

  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([state])
  @@index([expiresAt])
  @@map("oauth_authorization_requests")
}

/// Polymorphic append-only ledger spanning BOTH OAuthClient and OAuthConnection lifecycle events (discriminated by entityType) — avoids two near-identical history tables. No FK relation since entityId may reference either parent table.
model OAuthHistory {
  id          String @id @default(uuid())
  entityType  OAuthHistoryEntityType @map("entity_type")
  entityId    String @map("entity_id")
  workspaceId String? @map("workspace_id")

  changeType OAuthChangeType @map("change_type")
  fromStatus String?         @map("from_status")
  toStatus   String?         @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([entityType])
  @@map("oauth_history")
}

enum SsoScopeType {
  ORGANIZATION
  WORKSPACE
}

enum SsoProtocol {
  SAML
  OIDC
}

enum SsoConnectionStatus {
  ACTIVE
  DISABLED
  REVOKED
  ARCHIVED
}

enum SsoEnforcementPolicy {
  ENFORCED
  OPTIONAL
}

enum SsoLoginRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum SsoChangeType {
  CONNECTION_REGISTERED
  CONNECTION_UPDATED
  CONNECTION_ENABLED
  CONNECTION_DISABLED
  CONNECTION_REVOKED
  CONNECTION_ARCHIVED
  CERTIFICATE_ROTATED
  CLIENT_SECRET_ROTATED
  METADATA_REFRESHED
}

/// A configured enterprise identity-provider connection (SAML 2.0 or OIDC) — the tenant-level equivalent of `OAuthClient`, but for authenticating INTO ATLAS rather than ATLAS connecting out to a third-party API. Protocol-specific endpoints/certificates are admin-configured, never hardcoded, per-connection.
model SsoConnection {
  id             String       @id @default(uuid())
  workspaceId    String?      @map("workspace_id")
  organizationId String?      @map("organization_id")
  scopeType      SsoScopeType @map("scope_type")
  scopeKey       String       @map("scope_key")

  name        String
  description String?     @db.Text
  protocol    SsoProtocol

  status            SsoConnectionStatus  @default(ACTIVE)
  enforcementPolicy SsoEnforcementPolicy @default(OPTIONAL) @map("enforcement_policy")

  /// Email domains that route sign-in attempts to this connection (home-realm discovery).
  domains String[]
  /// OIDC scopes requested / SAML requested attribute names — protocol-dependent, admin-configured.
  scopes  String[]

  issuer   String? @db.Text
  entityId String? @map("entity_id") @db.Text
  clientId String? @map("client_id")

  metadataUrl       String?   @db.Text @map("metadata_url")
  metadataXml       String?   @db.Text @map("metadata_xml")
  metadataFetchedAt DateTime? @map("metadata_fetched_at")

  ssoUrl String? @db.Text @map("sso_url")
  sloUrl String? @db.Text @map("slo_url")

  authorizationEndpoint String? @db.Text @map("authorization_endpoint")
  tokenEndpoint         String? @db.Text @map("token_endpoint")
  jwksUri               String? @db.Text @map("jwks_uri")
  userInfoEndpoint      String? @db.Text @map("user_info_endpoint")
  endSessionEndpoint    String? @db.Text @map("end_session_endpoint")

  encryptedCertificate  String? @db.Text @map("encrypted_certificate")
  encryptedClientSecret String? @db.Text @map("encrypted_client_secret")

  jitProvisioningEnabled Boolean @default(true) @map("jit_provisioning_enabled")
  groupClaimName         String? @map("group_claim_name")
  /// `Role.id` (Roles & Permissions) assigned to JIT-provisioned users with no matching group mapping — resolved and stored by the admin at configuration time, never looked up cross-module at runtime.
  defaultRoleId          String? @map("default_role_id")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groupRoleMappings SsoGroupRoleMapping[]
  identities        SsoIdentity[]
  loginRequests     SsoLoginRequest[]
  history           SsoHistory[]

  @@unique([scopeKey, name])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([status])
  @@map("sso_connections")
}

/// External group/claim → ATLAS `Role.id` mapping, applied during JIT provisioning/re-login. `roleId` is admin-selected, not resolved via a cross-module lookup.
model SsoGroupRoleMapping {
  id            String @id @default(uuid())
  connectionId  String @map("connection_id")
  externalGroup String @map("external_group")
  roleId        String @map("role_id")
  priority      Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalGroup])
  @@index([connectionId])
  @@map("sso_group_role_mappings")
}

/// Persistent link between an external IdP identity and an ATLAS `User` — prevents duplicate identities/unauthorized re-linking via the `(connectionId, externalUserId)` unique constraint.
model SsoIdentity {
  id           String  @id @default(uuid())
  connectionId String  @map("connection_id")
  workspaceId  String? @map("workspace_id")
  userId       String  @map("user_id")

  externalUserId String   @map("external_user_id")
  externalEmail  String   @map("external_email")
  externalGroups String[] @map("external_groups")

  provisionedAt DateTime  @default(now()) @map("provisioned_at")
  lastLoginAt   DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalUserId])
  @@index([connectionId])
  @@index([userId])
  @@index([workspaceId])
  @@map("sso_identities")
}

/// Short-lived CSRF/replay-protection record for one SP-initiated login attempt (SAML AuthnRequest or OIDC authorization request) — also the durable record of login attempts, including failures, since a successful completion is itself "session creation" (the actual session is an ATLAS JWT pair, minted via `AuthenticationService.issueTokensForWorkspace`, not duplicated here).
model SsoLoginRequest {
  id             String  @id @default(uuid())
  connectionId   String  @map("connection_id")
  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  state      String  @unique
  nonce      String?
  relayState String? @db.Text @map("relay_state")

  domain String?

  status        SsoLoginRequestStatus @default(PENDING)
  failureReason String?               @db.Text @map("failure_reason")

  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([state])
  @@index([expiresAt])
  @@index([status])
  @@map("sso_login_requests")
}

/// Append-only configuration-change ledger for `SsoConnection` (registration/lifecycle/certificate/secret/metadata changes) — login attempts and failures are tracked on `SsoLoginRequest` instead, so this stays config-focused and low-volume.
model SsoHistory {
  id           String  @id @default(uuid())
  connectionId String  @map("connection_id")
  workspaceId  String? @map("workspace_id")

  changeType SsoChangeType @map("change_type")
  fromStatus String?       @map("from_status")
  toStatus   String?       @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  connection SsoConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("sso_history")
}

enum FeatureFlagType {
