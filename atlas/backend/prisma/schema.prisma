/// Line items/totals are a snapshot copied from Billing Engine's finalized `BillingItem`/`BillingPeriod` rows at generation time — never recalculated here.
model Invoice {
  id             String  @id @default(uuid())
  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")
  billingPeriodId String? @map("billing_period_id")
  subscriptionId  String? @map("subscription_id")

  invoiceNumber   String @map("invoice_number")
  invoiceSequence Int    @map("invoice_sequence")
  type            InvoiceType
  status          InvoiceStatus @default(DRAFT)

  currency      String
  subtotal      Float @default(0)
  discountTotal Float @default(0) @map("discount_total")
  creditTotal   Float @default(0) @map("credit_total")
  taxTotal      Float @default(0) @map("tax_total")
  total         Float @default(0)
  amountPaid    Float @default(0) @map("amount_paid")
  balanceDue    Float @default(0) @map("balance_due")

  lineItems    Json @default("[]") @map("line_items")
  taxBreakdown Json @default("[]") @map("tax_breakdown")

  issueDate DateTime? @map("issue_date")
  dueDate   DateTime  @map("due_date")

  documentId     String?               @map("document_id")
  deliveryStatus InvoiceDeliveryStatus @default(NOT_SENT) @map("delivery_status")
  deliveredAt    DateTime?             @map("delivered_at")
  lastSentAt     DateTime?             @map("last_sent_at")
  sendAttempts   Int                   @default(0) @map("send_attempts")
  downloadCount     Int       @default(0) @map("download_count")
  lastDownloadedAt  DateTime? @map("last_downloaded_at")

  paymentReference    Json? @map("payment_reference")
  refundReference     Json? @map("refund_reference")
  creditNoteReference Json? @map("credit_note_reference")
  externalReference   Json? @map("external_reference")

  voidedAt           DateTime? @map("voided_at")
  voidReason         String?   @db.Text @map("void_reason")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @db.Text @map("cancellation_reason")
  refundedAt         DateTime? @map("refunded_at")
  archivedAt         DateTime? @map("archived_at")

  idempotencyKey      String? @map("idempotency_key")
  version             Int     @default(1)
  supersedesInvoiceId String? @map("supersedes_invoice_id")

  metadata  Json    @default("{}")
  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history InvoiceHistory[]

  @@unique([workspaceId, invoiceNumber])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([billingPeriodId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([archivedAt])
  @@map("invoices")
}

/// Immutable — append-only lifecycle ledger, never updated or deleted afterward.
model InvoiceHistory {
  id          String @id @default(uuid())
  invoiceId   String @map("invoice_id")
  workspaceId String @map("workspace_id")

  changeType InvoiceChangeType @map("change_type")
  fromStatus InvoiceStatus?    @map("from_status")
