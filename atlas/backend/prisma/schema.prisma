model Country {
  id                 String    @id @default(cuid())
  code               String    @map("code") // ISO 3166-1 alpha-2, e.g. "US", "IN"
  name               String
  region             String?   // e.g. "NA", "EU", "APAC" — free-form grouping / hierarchy tag
  timezone           String
  locale             String    // default locale code (references the localization module's locale registry — not duplicated here)
  currency           String    // default ISO 4217 currency code
  language           String    // default ISO 639-1 language code
  supportedLocales   Json      @default("[]") @map("supported_locales") // additional locale codes usable in this country
  supportedCurrencies Json     @default("[]") @map("supported_currencies") // additional currency codes usable in this country
  supportedLanguages Json      @default("[]") @map("supported_languages") // additional language codes usable in this country
  taxRegime          String?   @map("tax_regime") // reference/label only — no tax calculation logic lives here
  complianceRefs     Json      @default("[]") @map("compliance_refs") // reference list only (external policy/doc ids)
  businessRules      Json      @default("{}") @map("business_rules") // reference/config only — no business-rule engine logic lives here
  status             String    @default("DRAFT")
  version            Int       @default(1)
  effectiveFrom      DateTime? @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  metadata           Json      @default("{}")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  history CountryHistory[]

  @@unique([code])
  @@index([status])
  @@index([region])
  @@index([deletedAt])
  @@map("countries")
}

