  // Marketplace tracking
  // Which connected MarketplaceAccount this was (or should be) published
  // through — required for real Amazon publishing so the correct seller's
  // credentials are used; null for marketplaces still on the mock path.
  marketplaceAccountId   String?                 @map("marketplace_account_id")
  marketplaceListingId   String?                 @map("marketplace_listing_id")
  marketplaceUrl         String?                 @map("marketplace_url")
  marketplaceResponse    Json?                   @map("marketplace_response")

  // Scheduling & timing
  trigger                PublishTrigger
  scheduledAt            DateTime?               @map("scheduled_at")
  publishedAt            DateTime?               @map("published_at")
  unpublishedAt          DateTime?               @map("unpublished_at")

  // Sync
  syncStatus             SyncStatus              @default(UNKNOWN)        @map("sync_status")
  lastSyncedAt           DateTime?               @map("last_synced_at")

  // Error
  errorCode              String?                 @map("error_code")
  errorMessage           String?                 @map("error_message")
  failedAt               DateTime?               @map("failed_at")
  retryCount             Int                     @default(0)              @map("retry_count")

  // Audit
  createdAt              DateTime                @default(now())          @map("created_at")
  updatedAt              DateTime                @updatedAt               @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")

  workspace              Workspace               @relation(fields: [workspaceId], references: [id])
  history                ListingPublicationHistory[]

  @@index([workspaceId])
  @@index([listingId])
  @@index([marketplace])
  @@index([status])
  @@index([marketplaceListingId])
  @@index([marketplaceAccountId])
  @@index([deletedAt])
  @@map("listing_publications")
}

model ListingPublicationHistory {
  id                   String                 @id @default(cuid())
  publicationId        String                 @map("publication_id")
  workspaceId          String                 @map("workspace_id")
  fromStatus           PublicationStatus      @map("from_status")
  toStatus             PublicationStatus      @map("to_status")
  publicationVersion   Int                    @map("publication_version")
  trigger              PublishTrigger
  reason               String?
  changedBy            String?                @map("changed_by")
  marketplaceListingId String?                @map("marketplace_listing_id")
  errorMessage         String?                @map("error_message")
  createdAt            DateTime               @default(now())            @map("created_at")

  publication          ListingPublication     @relation(fields: [publicationId], references: [id])

  @@index([publicationId])
  @@index([workspaceId])
  @@map("listing_publication_history")
}

