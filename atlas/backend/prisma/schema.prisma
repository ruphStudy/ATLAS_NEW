  history CurrencyHistory[]

  @@unique([code])
  @@index([status])
  @@index([deletedAt])
  @@map("currencies")
}

model CurrencyHistory {
  id           String   @id @default(cuid())
  currencyId   String   @map("currency_id")
  code         String
  version      Int
  status       String
  snapshot     Json     @default("{}")
  changeReason String?  @map("change_reason")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  currency Currency @relation(fields: [currencyId], references: [id])

  @@index([currencyId])
  @@index([code])
  @@map("currency_history")
}

model WorkspaceCurrencyConfig {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  baseCurrency          String    @map("base_currency")
  reportingCurrency     String?   @map("reporting_currency")
  staleToleranceMinutes Int       @default(1440) @map("stale_tolerance_minutes") // default 24h
  configuration         Json      @default("{}")
  createdBy             String?   @map("created_by")
  updatedBy             String?   @map("updated_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  @@unique([workspaceId])
  @@index([workspaceId])
  @@map("workspace_currency_configs")
}

model ExchangeRate {
  id            String    @id @default(cuid())
  baseCurrency  String    @map("base_currency")
  quoteCurrency String    @map("quote_currency")
  rate          Float // matches the existing Float convention used for money/rate fields (e.g. PricingConfig.currencyConversionRate) — never hardcoded, always ingested
  rateType      String    @default("SPOT") @map("rate_type") // SPOT | HISTORICAL | DAILY_CLOSE | CUSTOM
  source        String    // MANUAL | SCHEDULED | a registered provider key
  providerKey   String?   @map("provider_key")
  effectiveAt   DateTime  @map("effective_at")
  fetchedAt     DateTime  @default(now()) @map("fetched_at")
  status        String    @default("PUBLISHED") // DRAFT | PENDING_APPROVAL | APPROVED | PUBLISHED | REJECTED | ARCHIVED
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  publishedAt   DateTime? @map("published_at")
  isAbnormal    Boolean   @default(false) @map("is_abnormal")
  /// Points to the prior version this row supersedes — set only by `updateRate`. The superseded row is never mutated or deleted, preserving any finalized transaction that referenced it.
  supersedesId  String?   @map("supersedes_id")
  version       Int       @default(1)
  workspaceId   String?   @map("workspace_id") // null = global rate; set = workspace-scoped override rate
  metadata      Json      @default("{}")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  @@unique([baseCurrency, quoteCurrency, effectiveAt, workspaceId, source])
  @@index([baseCurrency, quoteCurrency])
  @@index([effectiveAt])
  @@index([workspaceId])
  @@index([status])
  @@index([supersedesId])
  @@index([deletedAt])
  @@map("exchange_rates")
}

model ExchangeRateProviderConfig {
  id          String    @id @default(cuid())
  workspaceId String?   @map("workspace_id") // null = global default priority/fallback order
  providerKey String    @map("provider_key")
  isEnabled   Boolean   @default(true) @map("is_enabled")
  priority    Int       @default(50) // lower = tried first, mirrors WorkspaceMarketplaceProviderConfig.priority
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
  @@map("exchange_rate_provider_configs")
}

// =============================================================
// Tax Engine
// =============================================================

model TaxJurisdiction {
  id          String    @id @default(cuid())
  code        String    @map("code") // e.g. "US-CA", "IN-KA", "GLOBAL"
  name        String
  countryCode String    @map("country_code")
  region      String?   // state/province code, if applicable
  level       String    @default("COUNTRY") // COUNTRY | STATE | REGION | CITY
  parentId    String?   @map("parent_id")
  status      String    @default("ACTIVE")
  metadata    Json      @default("{}")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([code])
  @@index([countryCode])
  @@index([parentId])
  @@index([status])
  @@map("tax_jurisdictions")
}

model TaxRule {
  id                 String    @id @default(cuid())
  ruleKey            String    @map("rule_key") // stable identifier shared across versions of the same rule
  name               String
  taxType            String    @map("tax_type") // SALES_TAX | GST | VAT | SERVICE_TAX | WITHHOLDING | CUSTOM
  jurisdictionCode   String    @map("jurisdiction_code")
  rate               Float // percentage, e.g. 18 for 18% — never hardcoded, always configured
  calculationMode    String    @default("EXCLUSIVE") @map("calculation_mode") // INCLUSIVE | EXCLUSIVE
  isCompound         Boolean   @default(false) @map("is_compound")
  compoundOnRuleKeys Json      @default("[]") @map("compound_on_rule_keys") // rule keys this rate compounds on top of
  reverseCharge      Boolean   @default(false) @map("reverse_charge")
  priority           Int       @default(50) // lower = applied first, mirrors the priority convention used across the provider frameworks
  applicability      Json      @default("{}") // configuration-driven matchers: marketplaceKeys, productCategories, customerTypes, transactionTypes, etc.
  exemptions         Json      @default("[]") // exemption codes this rule does not apply to
  thresholds         Json      @default("{}") // e.g. { minAmount, maxAmount, currency }
  workspaceId        String?   @map("workspace_id") // null = global rule
  status             String    @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | PUBLISHED | ARCHIVED
  version            Int       @default(1)
  /// Points to the prior version this row supersedes — the superseded row is never mutated, preserving any finalized transaction snapshot that referenced it.
  supersedesId       String?   @map("supersedes_id")
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  approvedBy         String?   @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  publishedAt        DateTime? @map("published_at")
  metadata           Json      @default("{}")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  history TaxRuleHistory[]

  @@index([ruleKey])
  @@index([jurisdictionCode])
  @@index([taxType])
  @@index([status])
  @@index([workspaceId])
  @@index([effectiveFrom])
  @@index([supersedesId])
  @@index([deletedAt])
  @@map("tax_rules")
}

model TaxRuleHistory {
  id           String   @id @default(cuid())
  ruleId       String   @map("rule_id")
  ruleKey      String   @map("rule_key")
  version      Int
  status       String
  snapshot     Json     @default("{}")
  changeReason String?  @map("change_reason")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  rule TaxRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId])
  @@index([ruleKey])
  @@map("tax_rule_history")
}

model TaxOverride {
  id               String    @id @default(cuid())
  workspaceId      String?   @map("workspace_id")
  organizationId   String?   @map("organization_id")
  ruleKey          String?   @map("rule_key") // null = matches broadly by jurisdiction/taxType instead of one specific rule
  jurisdictionCode String?   @map("jurisdiction_code")
  taxType          String?   @map("tax_type")
  overrideType     String    @map("override_type") // GLOBAL | ORGANIZATION | WORKSPACE
  overrideValue    Json      @default("{}") // e.g. { rate: X } or { exempt: true }
  /// Overrides must be authorized — this is never optional, per "tax overrides only through authorized/configured policies".
  authorizedBy     String    @map("authorized_by")
  priority         Int       @default(0)
  reason           String?
  effectiveFrom    DateTime? @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([ruleKey])
  @@index([jurisdictionCode])
  @@index([workspaceId])
  @@map("tax_overrides")
}

model TaxCalculationRecord {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  transactionType  String   @map("transaction_type") // PROCUREMENT | PRICING | ORDER | INVOICE | REFUND | SETTLEMENT | SAAS_BILLING
  transactionRef   String   @map("transaction_ref") // caller-supplied external id (order id, invoice id, ...)
  taxableBase      Float    @map("taxable_base")
  currency         String
  jurisdictionCode String   @map("jurisdiction_code")
  taxType          String   @map("tax_type")
  rate             Float
  taxAmount        Float    @map("tax_amount")
  calculationMode  String   @map("calculation_mode")
  ruleId           String?  @map("rule_id")
  ruleKey          String?  @map("rule_key")
  ruleVersion      Int?     @map("rule_version")
  isReverseCharge  Boolean  @default(false) @map("is_reverse_charge")
  isExempt         Boolean  @default(false) @map("is_exempt")
  breakdown        Json     @default("[]") // per-component breakdown for compound tax
  /// Immutable, append-only — a finalized transaction's tax snapshot is preserved here even if the rule it used is later changed or archived.
  calculatedAt     DateTime @default(now()) @map("calculated_at")
  effectiveDate    DateTime @map("effective_date") // the as-of date used to resolve the rule (historical calculation support)
  metadata         Json     @default("{}")
  createdBy        String?  @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([transactionType, transactionRef])
  @@index([jurisdictionCode])
  @@index([calculatedAt])
  @@map("tax_calculation_records")
}

// =============================================================
// GST/VAT Framework (built on Tax Engine — no rate/rule storage here)
// =============================================================

model GstVatRegistration {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  jurisdictionCode   String    @map("jurisdiction_code")
  taxType            String    @map("tax_type") // GST | VAT
  registrationNumber String    @map("registration_number")
  registrationType   String?   @map("registration_type") // e.g. REGULAR | COMPOSITION | NON_RESIDENT — country-specific label, configuration only
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED
  effectiveFrom      DateTime  @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  metadata           Json      @default("{}")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  history GstVatRegistrationHistory[]

  @@unique([workspaceId, jurisdictionCode, taxType])
  @@index([workspaceId])
  @@index([jurisdictionCode])
  @@index([status])
  @@map("gst_vat_registrations")
}

model GstVatRegistrationHistory {
  id             String   @id @default(cuid())
  registrationId String   @map("registration_id")
  workspaceId    String   @map("workspace_id")
  status         String
  snapshot       Json     @default("{}")
  changeReason   String?  @map("change_reason")
  changedBy      String?  @map("changed_by")
  createdAt      DateTime @default(now()) @map("created_at")

  registration GstVatRegistration @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
  @@map("gst_vat_registration_history")
}

model GstVatTaxCode {
  id               String    @id @default(cuid())
  code             String // e.g. an HSN/SAC code or any jurisdiction-specific classification code — never hardcoded, always configured
  description      String
  category         String? // GOODS | SERVICE
  taxType          String    @map("tax_type") // GST | VAT
  jurisdictionCode String?   @map("jurisdiction_code")
  ruleKey          String?   @map("rule_key") // links to a Tax Engine TaxRule.ruleKey for the default rate — this table never stores a rate itself
  isZeroRated      Boolean   @default(false) @map("is_zero_rated")
  status           String    @default("ACTIVE")
  workspaceId      String?   @map("workspace_id") // null = global code
  metadata         Json      @default("{}")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@unique([code, jurisdictionCode, workspaceId])
  @@index([taxType])
  @@index([jurisdictionCode])
  @@index([workspaceId])
  @@map("gst_vat_tax_codes")
}

model GstVatTransaction {
  id                          String    @id @default(cuid())
  workspaceId                 String    @map("workspace_id")
  /// References the Tax Engine's own immutable `TaxCalculationRecord` — the actual rate/amount/rule snapshot lives there and is never duplicated here.
  taxCalculationRecordId      String    @map("tax_calculation_record_id")
  direction                   String // INPUT | OUTPUT
  treatment                   String // STANDARD | INTRA_REGION | INTER_REGION | REVERSE_CHARGE | ZERO_RATED | EXEMPT
  registrationId              String?   @map("registration_id")
  taxCodeId                   String?   @map("tax_code_id")
  originJurisdictionCode      String?   @map("origin_jurisdiction_code")
  destinationJurisdictionCode String    @map("destination_jurisdiction_code")
  isItcEligible                Boolean  @default(false) @map("is_itc_eligible")
  itcAmount                    Float?   @map("itc_amount")
  transactionType              String   @map("transaction_type") // mirrors Tax Engine's TaxTransactionType
  transactionRef                String  @map("transaction_ref")
  status                       String   @default("RECORDED") // RECORDED | ADJUSTED | REVERSED
  metadata                     Json     @default("{}")
  createdBy                    String?  @map("created_by")
  createdAt                    DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([taxCalculationRecordId])
  @@index([transactionType, transactionRef])
  @@index([direction])
  @@index([status])
  @@map("gst_vat_transactions")
}

model GstVatAdjustment {
  id                     String   @id @default(cuid())
  workspaceId            String   @map("workspace_id")
  /// The original `GstVatTransaction` this adjusts — never mutated, only referenced, so the original tax snapshot stays intact.
  originalTransactionId  String   @map("original_transaction_id")
  adjustmentType         String   @map("adjustment_type") // CREDIT_NOTE | DEBIT_NOTE | REVERSAL
  reason                 String?
  taxCalculationRecordId String?  @map("tax_calculation_record_id") // set when the adjustment amount was computed via the Tax Engine
  amount                 Float
  currency               String
  status                 String   @default("RECORDED")
  metadata               Json     @default("{}")
  createdBy              String?  @map("created_by")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([originalTransactionId])
  @@map("gst_vat_adjustments")
}

// =============================================================
// Compliance Framework
// (central, configuration-driven requirement tracking — no
// country/marketplace regulation is ever hardcoded here; every rule
// is data, scoped optionally by country, region, marketplace,
// product category, supplier, warehouse and business type)
// =============================================================

model ComplianceRequirementRule {
  id          String  @id @default(cuid())
  workspaceId String? @map("workspace_id") // null = global default rule
  organizationId String? @map("organization_id")
  key         String // stable business key shared across versions, e.g. "FDA_FOOD_LICENSE"
  name        String
  description String?

  requirementType String // REGISTRATION | LICENSE | CERTIFICATION | DECLARATION | DOCUMENT | POLICY
  actions         String[] @default([]) @map("actions") // SUPPLIER_APPROVAL | PROCUREMENT | LISTING | MARKETPLACE_PUBLISHING | WAREHOUSE_OPERATION | OTHER

  // Scope — all optional; null means "wildcard" for that dimension.
  countryCode      String? @map("country_code")
  region           String?
  marketplaceKey   String? @map("marketplace_key")
  productCategory  String? @map("product_category")
  supplierId       String? @map("supplier_id")
  warehouseId      String? @map("warehouse_id")
  businessType     String? @map("business_type")

  mandatory  Boolean @default(true)
  thresholds Json    @default("{}")
  exemptionCodes String[] @default([]) @map("exemption_codes")

  renewalPeriodDays        Int? @map("renewal_period_days")
  reminderDaysBeforeExpiry Int? @map("reminder_days_before_expiry")

  priority Int @default(0) // tie-break when more than one rule of equal specificity matches the same key

  status        String    @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  version       Int       @default(1)
  supersedesId  String?   @map("supersedes_id") // set when this row is a new draft version of a previously ACTIVE rule
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  metadata  Json      @default("{}")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  history ComplianceRequirementRuleHistory[]

  @@index([workspaceId])
  @@index([key])
  @@index([countryCode])
  @@index([marketplaceKey])
  @@index([status])
  @@map("compliance_requirement_rules")
}

model ComplianceRequirementRuleHistory {
  id           String   @id @default(cuid())
  ruleId       String   @map("rule_id")
  workspaceId  String?  @map("workspace_id")
  status       String
  version      Int
  snapshot     Json     @default("{}")
  changeReason String?  @map("change_reason")
  changedBy    String?  @map("changed_by")
  createdAt    DateTime @default(now()) @map("created_at")

  rule ComplianceRequirementRule @relation(fields: [ruleId], references: [id])

  @@index([ruleId])
  @@map("compliance_requirement_rule_history")
}

model ComplianceRecord {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")

  ruleId      String @map("rule_id")
  ruleKey     String @map("rule_key") // denormalized for lookup/reporting convenience
  ruleVersion Int    @map("rule_version") // the rule version this record was last evaluated against

  subjectType String @map("subject_type") // SUPPLIER | WAREHOUSE | MARKETPLACE_LISTING | PRODUCT | ORGANIZATION | PROCUREMENT_ORDER | OTHER
  subjectId   String @map("subject_id")

  status String @default("REQUIRED") // REQUIRED | PENDING | COMPLIANT | EXPIRING | EXPIRED | REJECTED | WAIVED | NON_APPLICABLE

  referenceNumber String? @map("reference_number") // the registration/license/certificate number itself
  issuedAt        DateTime? @map("issued_at")
  expiresAt       DateTime? @map("expires_at")

  /// Points at an existing Document Management `Document.id` — the evidence file itself is never duplicated here.
  evidenceDocumentId String? @map("evidence_document_id")

  /// Immutable snapshot of the rule + context used at the last evaluation — preserved even if the rule later changes.
  evaluationSnapshot Json      @default("{}") @map("evaluation_snapshot")
  lastCheckedAt      DateTime? @map("last_checked_at")

  reviewedBy     String?  @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  decisionReason String?  @map("decision_reason")
  isOverride     Boolean  @default(false) @map("is_override")

  metadata  Json      @default("{}")
  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([workspaceId, ruleId, subjectType, subjectId])
  @@index([workspaceId, subjectType, subjectId])
  @@index([status])
  @@index([expiresAt])
  @@map("compliance_records")
}

model ComplianceRecordHistory {
  id          String   @id @default(cuid())
  recordId    String   @map("record_id")
  workspaceId String   @map("workspace_id")
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?
  changedBy   String?  @map("changed_by")
  snapshot    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([recordId])
  @@map("compliance_record_history")
}

