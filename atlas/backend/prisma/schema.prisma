/// Immutable append-only ledger of EVERY platform-admin action across ALL tenants — deliberately separate from `AuditLogsService` (whose records are scoped to ONE workspace each) since a platform admin acts FROM no workspace of their own UPON a target tenant; this table is what answers "everything platform admin X has done, across every tenant" cleanly. Every write here is ALSO mirrored into Audit Logs (scoped to the target workspace) so the existing audit pattern is reused, not replaced.
model AdminActionLog {
  id         String           @id @default(uuid())
  actionType AdminActionType @map("action_type")

  targetWorkspaceId String? @map("target_workspace_id")
  targetUserId      String? @map("target_user_id")

  performedBy String  @map("performed_by")
  reason      String? @db.Text
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([targetWorkspaceId])
  @@index([performedBy])
  @@index([actionType])
  @@map("admin_action_log")
}

/// A tracked platform-admin impersonation session — the JWT minted for the impersonated session carries no special claim (the shared `AuthenticationService.issueTokensForWorkspace()` payload shape is fixed and is not modified for this), so THIS row is the durable record of who impersonated whom, why, and for how long.
model ImpersonationSession {
  id String @id @default(uuid())

  adminUserId       String @map("admin_user_id")
  targetUserId      String @map("target_user_id")
  targetWorkspaceId String @map("target_workspace_id")

  reason    String  @db.Text
  ipAddress String? @map("ip_address")

  status ImpersonationStatus @default(ACTIVE)

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([targetWorkspaceId])
  @@index([status])
  @@map("impersonation_sessions")
}

