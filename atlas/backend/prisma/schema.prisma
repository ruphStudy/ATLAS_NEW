}

/// Configuration-driven quota definition — the enforcement/policy layer Plan Management explicitly says it does NOT provide ("no Usage/Quota enforcement engine here" per `IPlanLimit`'s own doc comment). Consumed usage is NEVER queried directly from `UsageRecord` — always via `UsageTrackingService.getCurrentUsage()`/`getUsageSummary()`. `feature` uses an empty-string sentinel (not null) so the identity tuple stays usable in a real unique constraint.
model QuotaPolicy {
  id             String         @id @default(uuid())
  workspaceId    String?        @map("workspace_id")
  organizationId String?        @map("organization_id")
  scopeType      QuotaScopeType @map("scope_type")
  scopeKey       String         @map("scope_key")

  resourceKey String @map("resource_key")
  feature     String @default("")

  /// For PLAN scope — `Plan.code` (Plan Management), admin-selected, never resolved by a cross-module lookup at policy-definition time.
  planKey String? @map("plan_key")

  unit String?

  softLimit   Float? @map("soft_limit")
  hardLimit   Float? @map("hard_limit")
  /// Fraction of `hardLimit` (0-1) at which state transitions to WARNING ahead of actually reaching the hard limit.
  graceThreshold Float? @map("grace_threshold")

  overageAllowed Boolean @default(false) @map("overage_allowed")
  /// Ceiling beyond `hardLimit` before BLOCKED kicks in, when `overageAllowed` is true — `null` means unlimited overage (never blocks).
  overageLimit   Float?  @map("overage_limit")

  resetSchedule           QuotaResetSchedule @default(BILLING_CYCLE) @map("reset_schedule")
  customResetIntervalDays Int?               @map("custom_reset_interval_days")

  status  QuotaPolicyStatus @default(ACTIVE)
  version Int               @default(1)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  overrides QuotaOverride[]
  states    QuotaState[]

  @@unique([scopeKey, resourceKey, feature])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeType])
  @@index([status])
  @@map("quota_policies")
}

/// A temporary (or, with `expiresAt: null`, permanent) admin-granted increase layered on top of whatever a `QuotaPolicy` resolves to — additive (`additionalHardLimit`), not a full limit replacement, so it composes cleanly regardless of the underlying policy's own value.
model QuotaOverride {
  id       String  @id @default(uuid())
  policyId String  @map("policy_id")

  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")
  scopeKey       String  @map("scope_key")

  resourceKey String @map("resource_key")
  feature     String @default("")

  additionalHardLimit Float? @map("additional_hard_limit")

  reason String @db.Text

  status    QuotaOverrideStatus @default(ACTIVE)
  expiresAt DateTime?           @map("expires_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  policy QuotaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([workspaceId])
  @@index([scopeKey])
  @@index([status])
  @@index([expiresAt])
  @@map("quota_overrides")
}

/// The live, per-scope enforcement state Quota Management maintains itself — distinct from anything Usage Tracking tracks (Usage Tracking is purely observational; this is the actual allow/block decision state, including the BLOCKED/RESTORED states Usage Tracking has no concept of).
/// `policyId` is nullable: a state row can exist for a resource that has no explicit `QuotaPolicy` yet, falling back to Plan Management's raw declared limit — the FK is best-effort (`SetNull` on policy removal), not a hard dependency.
model QuotaState {
  id       String  @id @default(uuid())
  policyId String? @map("policy_id")

  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")
  scopeKey       String  @map("scope_key")

  resourceKey String @map("resource_key")
  feature     String @default("")

  state QuotaEnforcementState @default(OK)

  consumedAtLastCheck Float    @default(0) @map("consumed_at_last_check")
  limitAtLastCheck    Float?   @map("limit_at_last_check")
  lastEvaluatedAt     DateTime @default(now()) @map("last_evaluated_at")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  lastResetAt        DateTime? @map("last_reset_at")
  nextResetAt        DateTime? @map("next_reset_at")

  blockedAt DateTime? @map("blocked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  policy QuotaPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@unique([scopeKey, resourceKey, feature])
  @@index([policyId])
  @@index([workspaceId])
  @@index([state])
  @@index([nextResetAt])
  @@map("quota_states")
}

/// Polymorphic append-only ledger spanning policy changes, overrides and state transitions (discriminated by entityType) — avoids three near-identical history tables. No FK relation since entityId may reference any of three parent tables.
model QuotaHistory {
  id          String @id @default(uuid())
  entityType  QuotaHistoryEntityType @map("entity_type")
  entityId    String @map("entity_id")
  workspaceId String? @map("workspace_id")
  resourceKey String @map("resource_key")

  changeType QuotaChangeType @map("change_type")
  fromValue  Json?           @map("from_value")
  toValue    Json?           @map("to_value")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([workspaceId])
  @@index([resourceKey])
  @@map("quota_history")
}

