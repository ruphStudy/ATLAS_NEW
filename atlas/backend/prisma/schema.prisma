  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

/// `providerKey` is a free-form string (not a closed enum) so a future provider never requires a schema change — the same open-registry convention as `MarketplaceProviderAccount`.
model PaymentProviderAccount {
  id             String  @id @default(uuid())
  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")

  providerKey   String @map("provider_key")
  accountHandle String @map("account_handle")
  displayName   String? @map("display_name")

  country  String?
  currency String?

  status   PaymentProviderAccountStatus @default(PENDING_VERIFICATION)
  priority Int                          @default(100)
  isDefault Boolean                     @default(false) @map("is_default")

  capabilities        String[] @map("capabilities")
  supportedCountries  String[] @map("supported_countries")
  supportedCurrencies String[] @map("supported_currencies")

  healthState         PaymentHealthState @default(HEALTHY) @map("health_state")
  consecutiveFailures Int                @default(0) @map("consecutive_failures")

  lastTestedAt           DateTime? @map("last_tested_at")
  lastTestSuccess        Boolean?  @map("last_test_success")
  lastTestCorrelationId  String?   @map("last_test_correlation_id")

  metadata Json @default("{}")

  createdBy String? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  credentials    PaymentProviderCredential[]
  healthHistory  PaymentProviderHealthHistory[]

  @@unique([workspaceId, providerKey, accountHandle])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([status])
  @@index([deletedAt])
  @@map("payment_provider_accounts")
}

/// One row per account — fields individually AES-256-GCM encrypted (never raw card data; only provider API keys/tokens/webhook secrets).
model PaymentProviderCredential {
  id          String @id @default(uuid())
  accountId   String @map("account_id")
  workspaceId String @map("workspace_id")
  providerKey String @map("provider_key")

  encryptedFields   Json   @map("encrypted_fields")
  encryptionVersion String @default("v1") @map("encryption_version")
  status            String @default("ACTIVE")

  lastValidatedAt DateTime? @map("last_validated_at")
  lastRotatedAt   DateTime? @map("last_rotated_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account PaymentProviderAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId])
  @@index([workspaceId])
  @@map("payment_provider_credentials")
}

/// Normalized transaction ledger — `externalReference` holds only safe, normalized provider response fields, never raw secrets or card data.
model PaymentTransaction {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  accountId   String @map("account_id")
  providerKey String @map("provider_key")

  invoiceId       String? @map("invoice_id")
  billingPeriodId String? @map("billing_period_id")
  subscriptionId  String? @map("subscription_id")

  type   PaymentTransactionType
  status PaymentTransactionStatus @default(PENDING)

  amount         Float
  currency       String
  capturedAmount Float? @map("captured_amount")
  refundedAmount Float  @default(0) @map("refunded_amount")

  externalTransactionId String? @map("external_transaction_id")
  externalReference      Json?  @map("external_reference")
  idempotencyKey         String? @map("idempotency_key")
  parentTransactionId    String? @map("parent_transaction_id")

  errorCode    String? @map("error_code")
  errorMessage String? @db.Text @map("error_message")
  retryable    Boolean?

  requestedBy String? @map("requested_by")
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
  @@index([accountId])
  @@index([status])
  @@index([invoiceId])
  @@index([externalTransactionId])
  @@map("payment_transactions")
}

/// Dedupes on `(providerKey, externalEventId)` — `payload` holds only the normalized, safe fields the adapter extracted, never the raw provider secret/signature.
model PaymentWebhookEvent {
  id          String  @id @default(uuid())
  workspaceId String? @map("workspace_id")
  accountId   String? @map("account_id")
  providerKey String  @map("provider_key")

  externalEventId String               @map("external_event_id")
  eventType       String               @map("event_type")
  status          PaymentWebhookStatus @default(PENDING)
  signatureValid  Boolean              @default(false) @map("signature_valid")

  payload       Json
  failureReason String? @db.Text @map("failure_reason")
  processedAt   DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([providerKey, externalEventId])
  @@index([workspaceId])
  @@index([status])
  @@map("payment_webhook_events")
}

/// Immutable — append-only health-check ledger, never updated or deleted afterward.
model PaymentProviderHealthHistory {
  id          String @id @default(uuid())
  accountId   String @map("account_id")
  workspaceId String @map("workspace_id")

  fromState        PaymentHealthState?     @map("from_state")
  toState          PaymentHealthState      @map("to_state")
  connectionStatus PaymentConnectionStatus @map("connection_status")
  responseTimeMs   Int?                    @map("response_time_ms")
  errorMessage     String?                 @db.Text @map("error_message")

  checkedAt DateTime @default(now()) @map("checked_at")

  account PaymentProviderAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([workspaceId])
  @@map("payment_provider_health_history")
}

enum UsageRecordSource {
  API
  MANUAL_ENTRY
  EVENT_DRIVEN
  BATCH_IMPORT
  SYSTEM
}

enum UsageThresholdLevel {
  SOFT
  HARD
}

enum UsageCorrectionType {
  REVERSAL
  ADJUSTMENT
}

/// Generic, cross-module SaaS usage ledger — never duplicates AI Usage Tracking's own token/model-level metrics (that stays in `AiUsageRecord`); `resourceKey` uses the same open vocabulary as `Plan.limits`.
model UsageRecord {
  id             String  @id @default(uuid())
  workspaceId    String  @map("workspace_id")
  organizationId String? @map("organization_id")
  userId         String? @map("user_id")

  module      String
  feature     String?
  resourceKey String  @map("resource_key")

  quantity Float
  unit     String

  source        UsageRecordSource @default(API)
  correlationId String?           @map("correlation_id")

  billingPeriodId String? @map("billing_period_id")
  subscriptionId  String? @map("subscription_id")

  idempotencyKey String? @map("idempotency_key")

  occurredAt DateTime @map("occurred_at")
  recordedAt DateTime @default(now()) @map("recorded_at")

  isReversed   Boolean @default(false) @map("is_reversed")
  reversalOfId String? @map("reversal_of_id")

  metadata Json @default("{}")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, resourceKey, occurredAt])
  @@index([billingPeriodId])
  @@index([subscriptionId])
  @@index([correlationId])
  @@map("usage_records")
}

/// Immutable — append-only correction ledger; a correction never mutates or deletes the original `UsageRecord`, it only offsets it.
model UsageCorrection {
  id               String              @id @default(uuid())
  workspaceId      String              @map("workspace_id")
  originalRecordId String              @map("original_record_id")
  correctionType   UsageCorrectionType @map("correction_type")
  quantityDelta    Float               @map("quantity_delta")
  reason           String              @db.Text
  changedBy        String?             @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([originalRecordId])
  @@map("usage_corrections")
}

/// Append-only — one row per threshold crossing actually notified, used to dedupe repeat notifications within the same billing period.
model UsageThresholdEvent {
  id              String              @id @default(uuid())
  workspaceId     String              @map("workspace_id")
  resourceKey     String              @map("resource_key")
  level           UsageThresholdLevel
  currentQuantity Float               @map("current_quantity")
  limitQuantity   Float               @map("limit_quantity")
  billingPeriodId String?             @map("billing_period_id")

  notifiedAt DateTime @default(now()) @map("notified_at")

  @@index([workspaceId, resourceKey])
  @@index([billingPeriodId])
  @@map("usage_threshold_events")
}

enum ApiKeyScopeType {
  ORGANIZATION
  WORKSPACE
  USER
  SERVICE_ACCOUNT
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  REVOKED
  EXPIRED
}

enum ApiKeyChangeType {
  CREATED
  ROTATED
  REVOKED
  DISABLED
  ENABLED
  EXPIRED
}

/// Only `secretHash` (SHA-256 of the secret) is ever stored — the plaintext secret is generated at creation/rotation time, returned once in the response, and never persisted or logged.
model ApiKey {
  id             String  @id @default(uuid())
  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  scopeType ApiKeyScopeType @map("scope_type")
  scopeKey  String          @map("scope_key")

  name        String
  description String? @db.Text

  ownerUserId          String? @map("owner_user_id")
  serviceAccountHandle String? @map("service_account_handle")

  keyId      String @unique @map("key_id")
  secretHash String @map("secret_hash")

  status ApiKeyStatus @default(ACTIVE)

  scopes       String[]
  permissions  String[]
  environments String[] @default([])

  ipAllowlist        String[] @map("ip_allowlist")
  rateLimitPerMinute Int?     @map("rate_limit_per_minute")
  usageRestrictions  Json?    @map("usage_restrictions")

  expiresAt DateTime? @map("expires_at")

  lastUsedAt       DateTime? @map("last_used_at")
  usageCount       Int       @default(0) @map("usage_count")
  lastUsedIp       String?   @map("last_used_ip")
  lastUsedMetadata Json?     @map("last_used_metadata")

  rotatedFromId     String?   @map("rotated_from_id")
  rotatedToId       String?   @map("rotated_to_id")
  gracePeriodEndsAt DateTime? @map("grace_period_ends_at")

  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @db.Text @map("revoked_reason")
  disabledAt    DateTime? @map("disabled_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history ApiKeyHistory[]

  @@unique([scopeKey, name])
  @@index([workspaceId])
  @@index([scopeKey])
  @@index([status])
  @@index([expiresAt])
  @@index([gracePeriodEndsAt])
  @@map("api_keys")
}

/// Immutable — append-only lifecycle ledger (creation/rotation/revocation/etc. only, never per-request usage — that flows through Usage Tracking instead).
model ApiKeyHistory {
  id          String @id @default(uuid())
  apiKeyId    String @map("api_key_id")
  workspaceId String? @map("workspace_id")

  changeType ApiKeyChangeType @map("change_type")
  fromStatus ApiKeyStatus?    @map("from_status")
  toStatus   ApiKeyStatus?    @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@map("api_key_history")
}

enum WebhookScopeType {
  ORGANIZATION
  WORKSPACE
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  RETRYING
  DEAD_LETTERED
  CANCELLED
}

enum WebhookChangeType {
  CREATED
  UPDATED
  ENABLED
  DISABLED
  SECRET_ROTATED
  DELETED
}

model WebhookEndpoint {
  id             String           @id @default(uuid())
  workspaceId    String?          @map("workspace_id")
  organizationId String?          @map("organization_id")
  scopeType      WebhookScopeType @map("scope_type")
  scopeKey       String           @map("scope_key")

  name        String
  description String? @db.Text
  url         String  @db.Text

  eventTypes     String[] @map("event_types")
  headers        Json?
  payloadVersion String   @default("v1") @map("payload_version")

  status       WebhookEndpointStatus @default(ACTIVE)
  healthStatus WebhookHealthStatus   @default(HEALTHY) @map("health_status")

  encryptedSecret String @map("encrypted_secret") @db.Text

  retryMaxAttempts Int @default(5) @map("retry_max_attempts")
  retryBackoffMs   Int @default(5000) @map("retry_backoff_ms")

  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastDeliveryAt      DateTime? @map("last_delivery_at")
  lastSuccessAt       DateTime? @map("last_success_at")
  lastFailureAt       DateTime? @map("last_failure_at")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries WebhookDelivery[]
  history    WebhookHistory[]

  @@unique([scopeKey, name])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([scopeKey])
  @@index([status])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String  @id @default(uuid())
  endpointId  String  @map("endpoint_id")
  workspaceId String? @map("workspace_id")

  eventType      String @map("event_type")
  eventId        String @map("event_id")
  payloadVersion String @default("v1") @map("payload_version")
  payload        Json

  status       WebhookDeliveryStatus @default(PENDING)
  attemptCount Int                   @default(0) @map("attempt_count")
  maxAttempts  Int                   @map("max_attempts")

  responseStatus Int?    @map("response_status")
  responseBody   String? @db.Text @map("response_body")
  latencyMs      Int?    @map("latency_ms")
  errorMessage   String? @db.Text @map("error_message")

  nextRetryAt DateTime? @map("next_retry_at")
  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// Dedupe key (defaults to the source `eventId`) — the `@@unique` below is what makes re-dispatching the same source event to the same endpoint a no-op instead of a duplicate delivery.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, idempotencyKey])
  @@index([endpointId])
  @@index([workspaceId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([eventId])
  @@map("webhook_deliveries")
}

/// Immutable — append-only lifecycle ledger for endpoint config changes only (not per-delivery — that's WebhookDelivery). Deliberately NOT written to on endpoint deletion since `onDelete: Cascade` would immediately erase that very row along with the parent.
model WebhookHistory {
  id          String  @id @default(uuid())
  endpointId  String  @map("endpoint_id")
  workspaceId String? @map("workspace_id")

  changeType WebhookChangeType      @map("change_type")
  fromStatus WebhookEndpointStatus? @map("from_status")
  toStatus   WebhookEndpointStatus? @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@map("webhook_history")
}

enum OAuthScopeType {
  ORGANIZATION
  WORKSPACE
  USER
  SERVICE_ACCOUNT
}

