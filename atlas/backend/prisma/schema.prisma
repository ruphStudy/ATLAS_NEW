/// The structured, validated technical contract for one App Store `AppVersion` — capabilities/permissions/scopes/hooks/config-schema. Distinct from `AppVersion.manifest` (a loose Json snapshot); this is what the runtime actually enforces. `appKey`/`versionId` are plain string references to App Store's own tables (no cross-module FK relation, the established convention this session for cross-module identity references).
model PluginManifest {
  id        String @id @default(uuid())
  appKey    String @map("app_key")
  versionId String @map("version_id")

  capabilities        String[]
  requiredPermissions String[] @map("required_permissions")
  requiredScopes      String[] @map("required_scopes")
  hooks               String[]
  configSchema        Json?    @map("config_schema")

  minAtlasVersion String? @map("min_atlas_version")
  maxAtlasVersion String? @map("max_atlas_version")

  status PluginManifestStatus @default(ACTIVE)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activations PluginActivation[]

  @@unique([appKey, versionId])
  @@index([appKey])
  @@map("plugin_manifests")
}

/// The runtime counterpart to App Store's `AppInstallation` — `installationId` is a plain reference to that row (existence/eligibility already enforced there at install time, never re-checked here). `status` is the sandbox boundary: QUARANTINED means hook invocations are skipped entirely until manually reactivated, isolating a failing plugin from the rest of ATLAS.
model PluginActivation {
  id             String @id @default(uuid())
  manifestId     String @map("manifest_id")
  appKey         String @map("app_key")
  installationId String @map("installation_id")
  workspaceId    String @map("workspace_id")

  status             PluginActivationStatus @default(ACTIVE)
  /// The SUBSET of `PluginManifest.requiredPermissions` actually approved for this tenant — never more than the manifest declares.
  grantedPermissions String[]               @map("granted_permissions")

  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastInvokedAt       DateTime? @map("last_invoked_at")
  lastErrorAt         DateTime? @map("last_error_at")
  lastErrorMessage    String?   @db.Text @map("last_error_message")

  quarantinedAt     DateTime? @map("quarantined_at")
  quarantinedReason String?   @db.Text @map("quarantined_reason")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  manifest PluginManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([appKey, workspaceId])
  @@index([manifestId])
  @@index([workspaceId])
  @@index([status])
  @@map("plugin_activations")
}

/// Registry of where a plugin extends ATLAS (UI/workflow/event/webhook/data/analytics/automation) — `extensionPointKey` and `hookName` are both open, configuration-driven vocabularies, never enum-constrained.
model PluginExtensionPoint {
  id                String @id @default(uuid())
  appKey            String @map("app_key")
  extensionPointKey String @map("extension_point_key")
  hookName          String @map("hook_name")
  config            Json?

  status PluginExtensionPointStatus @default(ACTIVE)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appKey, extensionPointKey])
  @@index([appKey])
  @@index([extensionPointKey])
  @@map("plugin_extension_points")
}

/// A plugin's subscription to an internal ATLAS event name — `workspaceId: null` means the subscription applies across every tenant that has this plugin activated. Dispatch reuses Webhook Framework's own delivery/retry infrastructure entirely (see `PluginFrameworkService.triggerHook`) rather than a bespoke delivery mechanism.
model PluginEventSubscription {
  id          String @id @default(uuid())
  appKey      String @map("app_key")
  workspaceId String @map("workspace_id")
  eventName   String @map("event_name")
  targetHook  String @map("target_hook")

  status PluginSubscriptionStatus @default(ACTIVE)

  createdBy String? @map("created_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appKey, workspaceId, eventName])
  @@index([appKey])
  @@index([workspaceId])
  @@index([eventName])
  @@map("plugin_event_subscriptions")
}

/// Polymorphic append-only ledger spanning manifest/activation/extension-point/subscription lifecycle events (discriminated by entityType) — no FK relation since entityId may reference any of the four parent tables.
model PluginHistory {
  id          String @id @default(uuid())
  entityType  PluginHistoryEntityType @map("entity_type")
  entityId    String @map("entity_id")
  appKey      String @map("app_key")
  workspaceId String? @map("workspace_id")

  changeType PluginChangeType @map("change_type")
  fromStatus String?          @map("from_status")
  toStatus   String?          @map("to_status")

  reason    String? @db.Text
  changedBy String? @map("changed_by")
  snapshot  Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@index([appKey])
  @@map("plugin_history")
}

enum SaasIncidentType {
  PRIVILEGE_ESCALATION
  DESTRUCTIVE_ACTION
  REPEATED_FAILURE
  SUSPICIOUS_CROSS_TENANT_ACCESS
  /// Raised by Enterprise Audit's policy-violation sweep for entries the source module itself flagged via `metadata.policyViolation` or logged under `AuditActionCategory.OVERRIDE` — reuses this same incident workflow rather than a parallel one.
  POLICY_VIOLATION
}

enum SaasIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum SaasAuditArchiveStatus {
  PENDING
  COMPLETED
  FAILED
}

/// The review-workflow record for a platform-security finding raised by SaaS Audit's detection sweep. Deliberately does NOT duplicate `AuditLogEntry` — every incident points back at the immutable entry(ies) that triggered it (`sourceAuditLogEntryId`/`relatedAuditLogEntryIds`, plain string references, no FK — same cross-module reference convention used throughout this session) rather than copying their contents.
model SaasSecurityIncident {
  id String @id @default(uuid())

  incidentType SaasIncidentType
  severity     AuditRiskLevel

  /// Null for a genuinely platform-wide finding (e.g. one actor spanning many tenants) that cannot be anchored to a single tenant.
  workspaceId    String? @map("workspace_id")
  organizationId String? @map("organization_id")

  actorId   String? @map("actor_id")
  actorType ActivityActorType? @map("actor_type")

  sourceAuditLogEntryId   String?  @map("source_audit_log_entry_id")
  relatedAuditLogEntryIds String[] @map("related_audit_log_entry_ids")

  summary String
  detail  String? @db.Text

  status SaasIncidentStatus @default(OPEN)

  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")

  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")
  resolutionNotes String?   @db.Text @map("resolution_notes")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([actorId])
  @@index([incidentType])
  @@index([status])
  @@index([createdAt])
  @@map("saas_security_incidents")
}

/// A tracked archive batch of `AuditLogEntry` rows exported to the shared `StorageModule` (`STORAGE_PROVIDER`) — genuine cold-storage archival, distinct from `AuditLogsService.purgeRetention()`'s plain delete-only retention purge. Never stores the entries themselves; only the pointer (`storageReference`) to where they were persisted.
model SaasAuditArchive {
  id String @id @default(uuid())

  /// Null for a platform-wide, cross-tenant archive batch.
  workspaceId String? @map("workspace_id")

  fromDate DateTime @map("from_date")
  toDate   DateTime @map("to_date")

  entryCount Int @default(0) @map("entry_count")

  storageReference String? @map("storage_reference")
  format           String  @default("JSON")

  status SaasAuditArchiveStatus @default(PENDING)

  requestedBy   String?   @map("requested_by")
  completedAt   DateTime? @map("completed_at")
  failureReason String?   @db.Text @map("failure_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("saas_audit_archives")
}

enum SaasHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
}

enum SaasHealthCheckTrigger {
  MANUAL
  SCHEDULED
}

enum SaasHealthIncidentStatus {
  OPEN
  RESOLVED
}

/// One row per (tenant, monitored SaaS module) — the current health state, upserted on every check. Same shape as `OperationsHealthSnapshot`, applied to the SaaS/platform-admin module family instead of the Sprint 9 business-operation modules.
model SaasHealthSnapshot {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  module      String
  status      SaasHealthStatus @default(HEALTHY)

  queueBacklog          Int     @default(0) @map("queue_backlog")
  queueFailedCount      Int     @default(0) @map("queue_failed_count")
  queueActiveCount      Int     @default(0) @map("queue_active_count")
  queuePaused           Boolean @default(false) @map("queue_paused")
  oldestWaitingJobAgeMs Int?    @map("oldest_waiting_job_age_ms")
  auditFailureCount     Int     @default(0) @map("audit_failure_count")

  consecutiveDegradedChecks Int @default(0) @map("consecutive_degraded_checks")
  consecutiveHealthyChecks  Int @default(0) @map("consecutive_healthy_checks")

  issues      Json
  safeSummary String? @db.Text @map("safe_summary")

  lastCheckedAt   DateTime  @map("last_checked_at")
  lastHealthyAt   DateTime? @map("last_healthy_at")
  lastDegradedAt  DateTime? @map("last_degraded_at")
  lastUnhealthyAt DateTime? @map("last_unhealthy_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, module])
  @@index([status])
  @@map("saas_health_snapshots")
}

model SaasHealthIncident {
  id          String                   @id @default(uuid())
  workspaceId String                   @map("workspace_id")
  module      String
  severity    SaasHealthStatus
  status      SaasHealthIncidentStatus @default(OPEN)

  triggerSummary String @db.Text @map("trigger_summary")
  issues         Json

  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")
  durationMs Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, module])
  @@index([status])
  @@map("saas_health_incidents")
}

/// Immutable — append-only per-check ledger, never updated or deleted afterward.
model SaasHealthCheckLog {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")
  module      String

  status         SaasHealthStatus
  previousStatus SaasHealthStatus?      @map("previous_status")
  trigger        SaasHealthCheckTrigger @default(MANUAL)

  queueBacklog      Int     @map("queue_backlog")
  queueFailedCount  Int     @map("queue_failed_count")
  auditFailureCount Int     @map("audit_failure_count")
  issues            Json
  safeSummary       String? @db.Text @map("safe_summary")

  checkedAt DateTime @default(now()) @map("checked_at")

  @@index([workspaceId, module])
  @@index([checkedAt])
  @@map("saas_health_check_logs")
}

enum SaasHealthLevel {
  HEALTHY
  DEGRADED
  UNHEALTHY
  OFFLINE
  MAINTENANCE
}

enum SaasHealthEvaluationTrigger {
  MANUAL
  SCHEDULED
  EVENT_DRIVEN
}

enum SaasHealthAggregateIncidentStatus {
  OPEN
  RESOLVED
}

/// One row per tenant — the current CONSOLIDATED health state, layering a composite score, extended status vocabulary (OFFLINE/MAINTENANCE) and cascading-dependency impact on top of SaaS Monitoring's already-computed per-module `SaasHealthSnapshot` rows. Never a duplicate of those snapshots — `moduleBreakdown` only references their status/score contribution, read fresh at evaluation time. Platform/organization views are computed live from these rows, never separately persisted.
model SaasHealthAggregateSnapshot {
  id          String          @id @default(uuid())
  workspaceId String          @unique @map("workspace_id")
  level       SaasHealthLevel @default(HEALTHY)
  healthScore Int             @default(100) @map("health_score")

  moduleBreakdown   Json @map("module_breakdown")
  cascadingImpacts  Json @map("cascading_impacts")
  dependencyIssues  Json @map("dependency_issues")

  consecutiveDegradedEvaluations Int @default(0) @map("consecutive_degraded_evaluations")
  consecutiveHealthyEvaluations  Int @default(0) @map("consecutive_healthy_evaluations")

  safeSummary String? @db.Text @map("safe_summary")

  lastEvaluatedAt DateTime  @map("last_evaluated_at")
  lastHealthyAt   DateTime? @map("last_healthy_at")
  lastDegradedAt  DateTime? @map("last_degraded_at")
  lastUnhealthyAt DateTime? @map("last_unhealthy_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([level])
  @@map("saas_health_aggregate_snapshots")
}

model SaasHealthAggregateIncident {
  id          String                            @id @default(uuid())
  workspaceId String                            @map("workspace_id")
  severity    SaasHealthLevel
  status      SaasHealthAggregateIncidentStatus @default(OPEN)

  triggerSummary  String   @db.Text @map("trigger_summary")
  affectedModules String[] @map("affected_modules")
  cascadingFrom   String[] @map("cascading_from")

  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")
  durationMs Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("saas_health_aggregate_incidents")
}

/// Immutable — append-only per-evaluation ledger, never updated or deleted afterward.
model SaasHealthEvaluationLog {
  id          String @id @default(uuid())
  workspaceId String @map("workspace_id")

  level         SaasHealthLevel
  previousLevel SaasHealthLevel?            @map("previous_level")
  trigger       SaasHealthEvaluationTrigger @default(MANUAL)
  healthScore   Int                         @map("health_score")

  moduleBreakdown Json    @map("module_breakdown")
  safeSummary     String? @db.Text @map("safe_summary")

  evaluatedAt DateTime @default(now()) @map("evaluated_at")

  @@index([workspaceId])
  @@index([evaluatedAt])
  @@map("saas_health_evaluation_logs")
}

/// A planned or active suppression window — while in effect for its scope (tenant-wide when `module` is null, platform-wide when `workspaceId` is null), evaluation reports MAINTENANCE instead of the computed level, so a known, deliberate outage never raises a false incident. Status (SCHEDULED/ACTIVE/COMPLETED) is derived live from `startAt`/`endAt`/`cancelledAt`, never stored, to avoid a background job keeping it in sync.
model SaasHealthMaintenanceWindow {
  id          String  @id @default(uuid())
  workspaceId String? @map("workspace_id")
  module      String?

  reason String @db.Text

  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  createdBy   String? @map("created_by")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([startAt, endAt])
  @@map("saas_health_maintenance_windows")
}



