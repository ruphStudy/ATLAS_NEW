// =============================================================
// Marketplace Listing Mapping Foundation
// =============================================================

enum MappingStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

enum CategoryMappingStatus {
  AUTO_MAPPED
  MANUALLY_MAPPED
  UNMAPPED
  INVALID
}

enum TransformationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

model MarketplaceSchemaConfig {
  id                  String        @id @default(cuid())
  workspaceId         String?       @map("workspace_id")
  marketplaceKey      String        @map("marketplace_key")
  country             String        @default("GLOBAL")
  region              String?
  locale              String        @default("en-US")
  currency            String        @default("USD")
  category            String?
  schemaVersion       String        @map("schema_version")
  status              MappingStatus @default(DRAFT)
  isDefault           Boolean       @default(false) @map("is_default")

  requiredFields      Json          @default("[]") @map("required_fields")
  optionalFields      Json          @default("[]") @map("optional_fields")
  mediaRequirements   Json          @default("{}") @map("media_requirements")
  variantRules        Json          @default("{}") @map("variant_rules")
  contentRules        Json          @default("{}") @map("content_rules")
  pricingRequirements Json          @default("{}") @map("pricing_requirements")

  effectiveFrom       DateTime?     @map("effective_from")
  effectiveTo         DateTime?     @map("effective_to")

  createdBy           String?       @map("created_by")
  approvedBy          String?       @map("approved_by")

  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt      @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  categoryMappings    MarketplaceCategoryMapping[]
  attributeMappings   MarketplaceAttributeMapping[]

  @@index([marketplaceKey])
  @@index([country])
  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
  @@map("marketplace_schema_configs")
}

model MarketplaceCategoryMapping {
  id                    String                @id @default(cuid())
  workspaceId           String?               @map("workspace_id")
  schemaId              String?               @map("schema_id")
  /// Legacy free-text universal label — kept for existing listing-mapping
  /// behavior. `categoryId` below is the new link into the generic,
  /// hierarchical Category taxonomy; the two are not auto-reconciled.
  universalCategory     String                @map("universal_category")
  categoryId            String?               @map("category_id")
  marketplaceKey        String                @map("marketplace_key")
  country               String                @default("GLOBAL")
  marketplaceCategory   String                @map("marketplace_category")
  marketplaceCategoryId String?               @map("marketplace_category_id")
  categoryPath          String?               @map("category_path")
  confidence            Int                   @default(0)
  status                CategoryMappingStatus @default(UNMAPPED)
  isManualOverride      Boolean               @default(false) @map("is_manual_override")
  version               Int                   @default(1)

  createdBy             String?               @map("created_by")
  updatedBy             String?               @map("updated_by")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt     @map("updated_at")

  schema                MarketplaceSchemaConfig? @relation(fields: [schemaId], references: [id])
  category              Category?                @relation(fields: [categoryId], references: [id])

  @@index([universalCategory])
  @@index([marketplaceKey])
  @@index([country])
  @@index([workspaceId])
  @@index([categoryId])
  @@map("marketplace_category_mappings")
}

model MarketplaceAttributeMapping {
  id                   String        @id @default(cuid())
  workspaceId          String?       @map("workspace_id")
  schemaId             String?       @map("schema_id")
  marketplaceKey       String        @map("marketplace_key")
  country              String        @default("GLOBAL")
  universalAttribute   String        @map("universal_attribute")
  marketplaceAttribute String        @map("marketplace_attribute")
  transformType        String        @map("transform_type")
  valueMapping         Json?         @map("value_mapping")
  unitConversion       Json?         @map("unit_conversion")
  defaultValue         Json?         @map("default_value")
  isRequired           Boolean       @default(false) @map("is_required")
  isManualOverride     Boolean       @default(false) @map("is_manual_override")
  conditions           Json?
  derivedExpression    String?       @map("derived_expression")
  version              Int           @default(1)
  status               MappingStatus @default(PUBLISHED)

  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt     @map("updated_at")

  schema               MarketplaceSchemaConfig? @relation(fields: [schemaId], references: [id])

  @@index([marketplaceKey])
  @@index([universalAttribute])
  @@index([workspaceId])
  @@map("marketplace_attribute_mappings")
}

model MarketplaceMappingConfig {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  marketplaceKey String        @map("marketplace_key")
  country        String        @default("GLOBAL")
  category       String?
  schemaVersion  String        @map("schema_version")
  status         MappingStatus @default(DRAFT)
  mappingVersion Int           @default(1) @map("mapping_version")
  isDefault      Boolean       @default(false) @map("is_default")
  overrides      Json?

  effectiveFrom  DateTime?     @map("effective_from")
  effectiveTo    DateTime?     @map("effective_to")
  publishedAt    DateTime?     @map("published_at")
  publishedBy    String?       @map("published_by")
  approvedBy     String?       @map("approved_by")
  createdBy      String?       @map("created_by")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt     @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  versionHistory MarketplaceMappingVersionHistory[]

  @@index([workspaceId])
  @@index([marketplaceKey])
  @@index([status])
  @@index([deletedAt])
  @@map("marketplace_mapping_configs")
}

model MarketplaceMappingVersionHistory {
  id             String                   @id @default(cuid())
  configId       String                   @map("config_id")
  workspaceId    String                   @map("workspace_id")
  mappingVersion Int                      @map("mapping_version")
  schemaVersion  String                   @map("schema_version")
  status         MappingStatus
  overrides      Json?
  changeNote     String?                  @map("change_note")
  createdBy      String?                  @map("created_by")
  approvedBy     String?                  @map("approved_by")
  effectiveFrom  DateTime?                @map("effective_from")

  createdAt      DateTime                 @default(now()) @map("created_at")

  config         MarketplaceMappingConfig @relation(fields: [configId], references: [id])

  @@index([configId])
  @@index([workspaceId])
  @@map("marketplace_mapping_version_history")
}

model MarketplaceTransformationJob {
  id               String                  @id @default(cuid())
  workspaceId      String                  @map("workspace_id")
  listingId        String                  @map("listing_id")
  catalogProductId String                  @map("catalog_product_id")
  marketplaceKey   String                  @map("marketplace_key")
  country          String                  @default("GLOBAL")
  schemaVersion    String                  @map("schema_version")
  status           TransformationJobStatus @default(PENDING)
  isDryRun         Boolean                 @default(false) @map("is_dry_run")

  payload          Json?
  fieldTrace       Json?                   @map("field_trace")
  warnings         Json?
  errors           Json?

  startedAt        DateTime?               @map("started_at")
  completedAt      DateTime?               @map("completed_at")
  failedAt         DateTime?               @map("failed_at")
  errorMessage     String?                 @map("error_message")
  retryCount       Int                     @default(0) @map("retry_count")

  triggeredBy      String?                 @map("triggered_by")

  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt     @map("updated_at")

  workspace        Workspace               @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([listingId])
  @@index([marketplaceKey])
  @@index([status])
  @@map("marketplace_transformation_jobs")
}
// =============================================================
// PRICING ENGINE – ENUMS
// =============================================================

enum PricingStrategy {
  FIXED
  MARGIN_BASED
  ROI_BASED
  COMPETITIVE
  RULE_BASED
  COST_PLUS
  MARKETPLACE_SPECIFIC
  REGIONAL
}

enum PricingStatus {
  DRAFT
  CALCULATING
  CALCULATED
  APPROVED
  ACTIVE
  ARCHIVED
  FAILED
}

enum MarketplaceListingStatus {
  PENDING_TRANSFORMATION
  TRANSFORMING
  TRANSFORMED
  VALIDATED
  VALIDATION_FAILED
  READY
  PUBLISHED
  FAILED
  ARCHIVED
}

// =============================================================
// PRICING ENGINE – MODELS
// =============================================================

model PricingConfig {
  id              String          @id @default(cuid())
  workspaceId     String          @map("workspace_id")
  marketplaceKey  String          @map("marketplace_key")
  country         String          @default("GLOBAL")
  currency        String          @default("USD")
  strategy        PricingStrategy @default(MARGIN_BASED)
  isDefault       Boolean         @default(false) @map("is_default")
  isActive        Boolean         @default(true) @map("is_active")

  // Fee components (percentages unless noted)
  commissionPct         Float?  @map("commission_pct")
  fulfilmentFeeFlat     Float?  @map("fulfilment_fee_flat")
  shippingFeeFlat       Float?  @map("shipping_fee_flat")
  paymentProcessingPct  Float?  @map("payment_processing_pct")
  packagingCostFlat     Float?  @map("packaging_cost_flat")
  advertisingCostPct    Float?  @map("advertising_cost_pct")
  taxPct                Float?  @map("tax_pct")

  // Target thresholds
  targetMarginPct       Float?  @map("target_margin_pct")
  targetRoi             Float?  @map("target_roi")
  minProfitFlat         Float?  @map("min_profit_flat")
  minMarginPct          Float?  @map("min_margin_pct")

  // Price adjustments
  marketplacePriceAdjustmentPct Float?  @map("marketplace_price_adjustment_pct")
  regionalPriceAdjustmentPct    Float?  @map("regional_price_adjustment_pct")
  currencyConversionRate        Float?  @map("currency_conversion_rate")

  // Flexible rule config
  rules   Json?

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt     @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  pricingRecords PricingRecord[]

  @@index([workspaceId])
  @@index([marketplaceKey])
  @@index([country])
  @@index([isActive])
  @@index([deletedAt])
  @@map("pricing_configs")
}

model PricingRecord {
  id               String          @id @default(cuid())
  workspaceId      String          @map("workspace_id")
  catalogProductId String          @map("catalog_product_id")
  configId         String?         @map("config_id")
  marketplaceKey   String          @map("marketplace_key")
  country          String          @default("GLOBAL")
  currency         String          @default("USD")
  strategy         PricingStrategy
  status           PricingStatus   @default(DRAFT)
  version          Int             @default(1)

  // Input costs
  baseCost         Float?  @map("base_cost")
  landedCost       Float?  @map("landed_cost")
  procurementCost  Float?  @map("procurement_cost")

  // Calculated fee components
  commissionAmount        Float?  @map("commission_amount")
  fulfilmentFeeAmount     Float?  @map("fulfilment_fee_amount")
  shippingFeeAmount       Float?  @map("shipping_fee_amount")
  paymentProcessingAmount Float?  @map("payment_processing_amount")
  packagingCostAmount     Float?  @map("packaging_cost_amount")
  advertisingCostAmount   Float?  @map("advertising_cost_amount")
  taxAmount               Float?  @map("tax_amount")
  promotionalDiscount     Float?  @map("promotional_discount")

  // Pricing outputs
  totalCost              Float?  @map("total_cost")
  suggestedSellingPrice  Float?  @map("suggested_selling_price")
  marketplaceSellingPrice Float? @map("marketplace_selling_price")
  compareAtPrice         Float?  @map("compare_at_price")
  estimatedProfit        Float?  @map("estimated_profit")
  estimatedMarginPct     Float?  @map("estimated_margin_pct")
  estimatedRoi           Float?  @map("estimated_roi")

  // Manual override
  manualOverridePrice Float?    @map("manual_override_price")
  manualOverrideBy    String?   @map("manual_override_by")
  manualOverrideAt    DateTime? @map("manual_override_at")

  // Scheduled price change
  scheduledPrice     Float?    @map("scheduled_price")
  scheduledAt        DateTime? @map("scheduled_at")

  // Validation
  isValid            Boolean   @default(false) @map("is_valid")
  validationErrors   Json?     @map("validation_errors")

  // Metadata
  calculationMeta  Json?     @map("calculation_meta")
  calculationSource String?  @map("calculation_source")

  errorMessage  String?   @map("error_message")
  failedAt      DateTime? @map("failed_at")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt     @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id])
  config     PricingConfig? @relation(fields: [configId], references: [id])
  history    PricingHistory[]

  @@index([workspaceId])
  @@index([catalogProductId])
  @@index([marketplaceKey])
  @@index([status])
  @@index([deletedAt])
  @@map("pricing_records")
}

model PricingHistory {
  id              String        @id @default(cuid())
  pricingRecordId String        @map("pricing_record_id")
  workspaceId     String        @map("workspace_id")
  version         Int
  strategy        PricingStrategy
  status          PricingStatus
  snapshotData    Json          @map("snapshot_data")
  changedBy       String?       @map("changed_by")
  changeNote      String?       @map("change_note")
  createdAt       DateTime      @default(now()) @map("created_at")

  pricingRecord PricingRecord @relation(fields: [pricingRecordId], references: [id])

  @@index([pricingRecordId])
  @@index([workspaceId])
  @@map("pricing_history")
}

