// =============================================================
// AI GUARDRAILS & SAFETY
// =============================================================

enum GuardrailStage {
  INPUT
  OUTPUT
  TOOL_USE
  ACTION
}

enum GuardrailCheckType {
  PATTERN_MATCH
  ALLOWLIST
  BLOCKLIST
  ROLE_PERMISSION
  TOOL_PERMISSION
  ACTION_LIMIT
}

enum GuardrailViolationCategory {
  PROMPT_INJECTION
  CREDENTIAL_EXPOSURE
  PII_EXPOSURE
  FINANCIAL_DATA_EXPOSURE
  CUSTOMER_DATA_EXPOSURE
  WORKSPACE_DATA_EXPOSURE
  DATA_LEAKAGE
  UNSAFE_CONTENT
  POLICY_VIOLATION
  UNSUPPORTED_CLAIM
  RISKY_AUTOMATION
  ALLOWLIST_VIOLATION
  BLOCKLIST_VIOLATION
  ROLE_PERMISSION_VIOLATION
  TOOL_PERMISSION_VIOLATION
  ACTION_LIMIT_EXCEEDED
  OTHER
}

enum GuardrailSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GuardrailDecision {
  ALLOW
  WARN
  REDACT
  BLOCK
  REQUIRE_REVIEW
  RETRY
  FALLBACK
}

enum GuardrailOverrideScope {
  GLOBAL
  WORKSPACE
  PROVIDER
  MODEL
}

enum GuardrailIncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum GuardrailApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum GuardrailEvaluationStatus {
  COMPLETED
  ERROR
}

model AiGuardrailRule {
  id                String                      @id @default(uuid())
  workspaceId       String?                     @map("workspace_id")

  name              String
  description       String?                     @db.Text

  stage             GuardrailStage
  category          GuardrailViolationCategory
  checkType         GuardrailCheckType          @map("check_type")

  capability        String?
  useCase           String?                     @map("use_case")
  modelProvider     String?                     @map("model_provider")

  enabled           Boolean                     @default(true)

  config            Json

  severity          GuardrailSeverity           @default(MEDIUM)
  decision          GuardrailDecision           @default(BLOCK)
  riskWeight        Float                       @default(1.0) @map("risk_weight")
  requiresApproval  Boolean                     @default(false) @map("requires_approval")

  priority          Int                         @default(0)
  stopOnMatch       Boolean                     @default(false) @map("stop_on_match")

  version           Int                         @default(1)

  tags              String[]
  metadata          Json                        @default("{}")

  createdBy         String?                     @map("created_by")
  updatedBy         String?                     @map("updated_by")

  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  deletedAt         DateTime?                   @map("deleted_at")

  versions          AiGuardrailRuleVersion[]
  overrides         AiGuardrailOverride[]
  evaluationResults AiGuardrailEvaluationResult[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([stage])
  @@index([category])
  @@index([checkType])
  @@index([capability])
  @@index([enabled])
  @@index([deletedAt])
  @@map("ai_guardrail_rules")
}

model AiGuardrailRuleVersion {
  id           String   @id @default(uuid())
  ruleId       String   @map("rule_id")
  workspaceId  String?  @map("workspace_id")

  version      Int

  snapshot     Json

  changeReason String?  @db.Text @map("change_reason")
  changedBy    String?  @map("changed_by")

  createdAt    DateTime @default(now()) @map("created_at")

  rule         AiGuardrailRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, version])
  @@index([ruleId])
  @@index([workspaceId])
  @@map("ai_guardrail_rule_versions")
}

model AiGuardrailOverride {
  id               String                  @id @default(uuid())
  scope            GuardrailOverrideScope  @default(GLOBAL)

  ruleId           String?                 @map("rule_id")
  workspaceId      String?                 @map("workspace_id")
  providerKey      String?                 @map("provider_key")
  modelId          String?                 @map("model_id")

  enabledOverride  Boolean?                @map("enabled_override")
  decisionOverride GuardrailDecision?      @map("decision_override")
  severityOverride GuardrailSeverity?      @map("severity_override")

  priority         Int                     @default(0)
  reason           String?                 @db.Text

  metadata         Json                    @default("{}")

  createdBy        String?                 @map("created_by")
  updatedBy        String?                 @map("updated_by")

  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")

  rule             AiGuardrailRule?        @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([modelId])
  @@index([scope])
  @@index([deletedAt])
  @@map("ai_guardrail_overrides")
}

model AiGuardrailEvaluation {
  id                    String                     @id @default(uuid())
  workspaceId           String                     @map("workspace_id")

  stage                 GuardrailStage
  status                GuardrailEvaluationStatus  @default(COMPLETED)

  capability            String?
  useCase               String?                    @map("use_case")
  modelProvider         String?                    @map("model_provider")
  modelId               String?                    @map("model_id")

  orchestratorRequestId String?                    @map("orchestrator_request_id")
  agentExecutionId      String?                    @map("agent_execution_id")
  workflowExecutionId   String?                    @map("workflow_execution_id")

  toolName              String?                    @map("tool_name")
  actionName            String?                    @map("action_name")

  userId                String?                    @map("user_id")
  userRole              String?                    @map("user_role")

  contentHash           String?                    @map("content_hash")
  contentLength         Int?                       @map("content_length")

  riskScore             Float                      @default(0) @map("risk_score")
  severity              GuardrailSeverity          @default(INFO)
  decision              GuardrailDecision          @default(ALLOW)
  reasons               String[]

  matchedRuleCount      Int                        @default(0) @map("matched_rule_count")
  requiresApproval      Boolean                    @default(false) @map("requires_approval")

  metadata              Json                       @default("{}")

  createdAt             DateTime                   @default(now()) @map("created_at")

  results               AiGuardrailEvaluationResult[]
  incidents             AiGuardrailIncident[]
  approvals             AiGuardrailApproval[]

  @@index([workspaceId])
  @@index([stage])
  @@index([decision])
  @@index([severity])
  @@index([orchestratorRequestId])
  @@index([agentExecutionId])
  @@index([workflowExecutionId])
  @@index([createdAt])
  @@map("ai_guardrail_evaluations")
}

model AiGuardrailEvaluationResult {
  id           String                     @id @default(uuid())
  evaluationId String                     @map("evaluation_id")
  workspaceId  String                     @map("workspace_id")

  ruleId       String?                    @map("rule_id")
  ruleName     String                     @map("rule_name")

  category     GuardrailViolationCategory
  matched      Boolean
  severity     GuardrailSeverity
  decision     GuardrailDecision

  reason       String                     @db.Text
  matchCount   Int                        @default(0) @map("match_count")

  metadata     Json                       @default("{}")

  createdAt    DateTime                   @default(now()) @map("created_at")

  evaluation   AiGuardrailEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  rule         AiGuardrailRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([evaluationId])
  @@index([workspaceId])
  @@index([ruleId])
  @@index([category])
  @@index([matched])
  @@map("ai_guardrail_evaluation_results")
}

model AiGuardrailIncident {
  id           String                     @id @default(uuid())
  workspaceId  String                     @map("workspace_id")
  evaluationId String?                    @map("evaluation_id")

  category     GuardrailViolationCategory
  severity     GuardrailSeverity
  decision     GuardrailDecision

  status       GuardrailIncidentStatus    @default(OPEN)

  description  String                     @db.Text

  reportedBy   String?                    @map("reported_by")
  assignedTo   String?                    @map("assigned_to")

  resolution   String?                    @db.Text
  resolvedAt   DateTime?                  @map("resolved_at")
  resolvedBy   String?                    @map("resolved_by")

  metadata     Json                       @default("{}")

  createdAt    DateTime                   @default(now()) @map("created_at")
  updatedAt    DateTime                   @updatedAt @map("updated_at")

