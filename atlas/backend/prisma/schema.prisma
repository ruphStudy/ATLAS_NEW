  metadata              Json                @default("{}")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  context               AiContext           @relation(fields: [contextId], references: [id], onDelete: Cascade)
  
  @@unique([cacheKey])
  @@index([contextId])
  @@index([workspaceId])
  @@index([cacheKey])
  @@index([expiresAt])
  @@map("ai_context_cache")
}

model AiContextEvent {
  id                    String              @id @default(uuid())
  contextId             String              @map("context_id")
  workspaceId           String              @map("workspace_id")
  
  eventType             String              @map("event_type")
  
  version               Int?
  
  oldStatus             String?             @map("old_status")
  newStatus             String?             @map("new_status")
  
  changesSummary        String?             @db.Text @map("changes_summary")
  
  triggeredBy           String?             @map("triggered_by")
  
  metadata              Json                @default("{}")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  
  context               AiContext           @relation(fields: [contextId], references: [id], onDelete: Cascade)
  
  @@index([contextId])
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
  @@map("ai_context_events")
}

