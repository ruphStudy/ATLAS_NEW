  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([channel])
  @@index([status])
  @@index([deletedAt])
  @@map("notification_provider_registry_entries")
}

model NotificationProviderConfig {
  id                   String    @id @default(uuid())
  workspaceId          String    @map("workspace_id")
  providerKey          String    @map("provider_key")
  channel              String

  name                 String
  status               String    @default("ACTIVE")
  priority             Int       @default(0)
  isFallback           Boolean   @default(false) @map("is_fallback")
  fallbackProviderKeys String[]  @map("fallback_provider_keys")

  version              Int       @default(1)
  effectiveFrom        DateTime? @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")

  settings             Json      @default("{}")
  timeoutMs            Int?      @map("timeout_ms")
  maxRetryAttempts     Int?      @map("max_retry_attempts")
  retryBackoffMs       Int?      @map("retry_backoff_ms")
  maxRequestsPerMinute Int?      @map("max_requests_per_minute")

  createdBy            String?   @map("created_by")
  updatedBy            String?   @map("updated_by")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  history              NotificationProviderConfigHistory[]

  @@unique([workspaceId, providerKey, channel])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([deletedAt])
  @@map("notification_provider_configs")
}

model NotificationProviderConfigHistory {
  id           String   @id @default(uuid())
  configId     String   @map("config_id")
  workspaceId  String   @map("workspace_id")
  providerKey  String   @map("provider_key")

  version      Int
  status       String
  snapshot     Json

  changeReason String?  @db.Text @map("change_reason")
  changedBy    String?  @map("changed_by")

  createdAt    DateTime @default(now()) @map("created_at")

  config       NotificationProviderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, version])
  @@index([configId])
  @@index([workspaceId])
  @@map("notification_provider_config_history")
}

model NotificationProviderCredential {
  id                String    @id @default(uuid())
  workspaceId       String    @map("workspace_id")
  providerKey       String    @map("provider_key")
  channel           String

  credentialSetName String    @map("credential_set_name")
  description       String?

  status            String    @default("PENDING_VALIDATION")
  version           Int       @default(1)

  /// JSON map of { fieldKey: "encVersion:iv:authTag:ciphertext" } — never plaintext.
  encryptedFields   Json      @default("{}") @map("encrypted_fields")
  encryptionVersion String    @default("v1") @map("encryption_version")

  expiresAt         DateTime? @map("expires_at")
  lastValidatedAt   DateTime? @map("last_validated_at")
  lastRotatedAt     DateTime? @map("last_rotated_at")

  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  history           NotificationProviderCredentialHistory[]

  @@unique([workspaceId, providerKey, credentialSetName])
  @@index([workspaceId])
  @@index([providerKey])
  @@index([channel])
  @@index([status])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("notification_provider_credentials")
}

model NotificationProviderCredentialHistory {
  id                String   @id @default(uuid())
  credentialId      String   @map("credential_id")
  workspaceId       String   @map("workspace_id")
  providerKey       String   @map("provider_key")

  version           Int
  status            String
  encryptedFields   Json     @default("{}") @map("encrypted_fields")
  encryptionVersion String   @default("v1") @map("encryption_version")

  changeReason      String?  @map("change_reason")
  changedBy         String?  @map("changed_by")

  createdAt         DateTime @default(now()) @map("created_at")

  credential        NotificationProviderCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, version])
  @@index([credentialId])
  @@index([workspaceId])
  @@map("notification_provider_credential_history")
}

model NotificationDelivery {
  id               String    @id @default(uuid())
