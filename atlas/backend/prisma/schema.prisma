// AI Decision Engine
// ═══════════════════════════════════════════════════════════════════════════

enum AiDecisionStatus {
  PENDING
  EVALUATING
  APPROVED
  REJECTED
  REVIEW_REQUIRED
  DEFERRED
  OVERRIDDEN
  EXPIRED
}

enum AiDecisionType {
  PRODUCT_SELECTION
  SUPPLIER_SELECTION
  PRICING
  REORDER
  MARKETPLACE
  INVENTORY
  OPERATIONAL
  CUSTOM
}

enum AiDecisionMethod {
  RULE_BASED
  AI_ASSISTED
  WEIGHTED_SCORING
  HYBRID
}

enum AiDecisionOutcome {
  APPROVE
  REJECT
  REVIEW_REQUIRED
  DEFERRED
}

enum AiDecisionOverrideReason {
  BUSINESS_JUDGMENT
  INCORRECT_DATA
  CHANGED_REQUIREMENTS
  EMERGENCY
  POLICY_EXCEPTION
  OTHER
}

model AiDecision {
  id                      String              @id @default(uuid())
  workspaceId             String              @map("workspace_id")

  status                  AiDecisionStatus    @default(PENDING)
  decisionType            AiDecisionType      @map("decision_type")
  decisionMethod          AiDecisionMethod    @map("decision_method")

  orchestratorRequestId   String?             @map("orchestrator_request_id")
  agentExecutionId        String?             @map("agent_execution_id")
  workflowExecutionId     String?             @map("workflow_execution_id")
  validationId            String?             @map("validation_id")

  capability              String?
  useCase                 String?             @map("use_case")
  context                 String?

  inputSnapshot           Json                @map("input_snapshot")
  constraints             Json                @default("{}")
  objectives              Json                @default("{}")

  outcome                 AiDecisionOutcome?
  selectedCandidateId     String?             @map("selected_candidate_id")
  
  finalScore              Float?              @map("final_score")
  confidenceScore         Float?              @map("confidence_score")
  rationale               String?
  risks                   Json                @default("[]")
  alternatives            Json                @default("[]")
  supportingEvidence      Json                @default("{}") @map("supporting_evidence")

  modelProvider           String?             @map("model_provider")
  modelName               String?             @map("model_name")
  ruleVersion             String?             @map("rule_version")

  requiresHumanApproval   Boolean             @default(false) @map("requires_human_approval")
  approvedBy              String?             @map("approved_by")
  approvedAt              DateTime?           @map("approved_at")
  reviewedBy              String?             @map("reviewed_by")
  reviewedAt              DateTime?           @map("reviewed_at")

  idempotencyKey          String?             @unique @map("idempotency_key")
  expiresAt               DateTime?           @map("expires_at")

  evaluationStartTime     DateTime?           @map("evaluation_start_time")
  evaluationEndTime       DateTime?           @map("evaluation_end_time")
  evaluationDuration      Int?                @map("evaluation_duration")

  tags                    String[]            @default([])
  metadata                Json                @default("{}")

  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  candidates              AiDecisionCandidate[]
  history                 AiDecisionHistory[]
  overrides               AiDecisionOverride[]

  @@index([workspaceId])
  @@index([status])
  @@index([decisionType])
  @@index([orchestratorRequestId])
  @@index([agentExecutionId])
  @@index([workflowExecutionId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("ai_decisions")
}

model AiDecisionCandidate {
  id              String          @id @default(uuid())
  decisionId      String          @map("decision_id")
  workspaceId     String          @map("workspace_id")

  candidateData   Json            @map("candidate_data")
  candidateLabel  String?         @map("candidate_label")
  
  score           Float?
  scores          Json            @default("{}")
  
  selected        Boolean         @default(false)
  rank            Int?

  pros            Json            @default("[]")
  cons            Json            @default("[]")
  
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")

  decision        AiDecision      @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([workspaceId])
  @@index([selected])
  @@map("ai_decision_candidates")
}

model AiDecisionRule {
  id              String          @id @default(uuid())
  workspaceId     String?         @map("workspace_id")

  name            String
  decisionType    String          @map("decision_type")
  method          String

  capability      String?
  useCase         String?         @map("use_case")

  ruleConfig      Json            @map("rule_config")
  weights         Json            @default("{}")
  thresholds      Json            @default("{}")

  priority        Int             @default(0)
  enabled         Boolean         @default(true)

  requiresApproval Boolean        @default(false) @map("requires_approval")
  approvalThreshold Float?        @map("approval_threshold")

  version         String          @default("1.0")

  tags            String[]        @default([])
  metadata        Json            @default("{}")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([decisionType])
  @@index([enabled])
  @@index([deletedAt])
  @@map("ai_decision_rules")
}

model AiDecisionHistory {
  id              String          @id @default(uuid())
  decisionId      String          @map("decision_id")
  workspaceId     String          @map("workspace_id")

  action          String
  oldStatus       String?         @map("old_status")
  newStatus       String?         @map("new_status")

  changedBy       String?         @map("changed_by")
  reason          String?
  details         String?

  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at")

  decision        AiDecision      @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([workspaceId])
  @@index([createdAt])
  @@map("ai_decision_history")
}

model AiDecisionOverride {
  id              String                      @id @default(uuid())
  decisionId      String                      @map("decision_id")
  workspaceId     String                      @map("workspace_id")

  overrideReason  AiDecisionOverrideReason    @map("override_reason")
  reasonText      String?                     @map("reason_text")

  originalOutcome AiDecisionOutcome           @map("original_outcome")
  newOutcome      AiDecisionOutcome           @map("new_outcome")

  originalCandidateId String?                 @map("original_candidate_id")
  newCandidateId  String?                     @map("new_candidate_id")

  overriddenBy    String                      @map("overridden_by")
  approvedBy      String?                     @map("approved_by")

  metadata        Json                        @default("{}")
  createdAt       DateTime                    @default(now()) @map("created_at")

  decision        AiDecision                  @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([workspaceId])
  @@index([overriddenBy])
  @@index([createdAt])
  @@map("ai_decision_overrides")
}

