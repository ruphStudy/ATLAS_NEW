# =============================================================
# ATLAS – Development Environment
# Loaded when NODE_ENV=development
# =============================================================

APP_NAME=ATLAS API (Dev)
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

DATABASE_URL=postgresql://atlas_user:atlas_password@localhost:5432/atlas_db?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=atlas_redis_password

JWT_SECRET=atlas-dev-jwt-secret-minimum-32-chars-change-for-prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=atlas-dev-refresh-secret-min-32-chars-change-prod
JWT_REFRESH_EXPIRES_IN=30d

LOG_LEVEL=debug

SWAGGER_ENABLED=true
SWAGGER_TITLE=ATLAS API – Development
SWAGGER_DESCRIPTION=ATLAS AI Commerce Operating System API (Development)
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs
