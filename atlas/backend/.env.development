# =============================================================
# ATLAS – Development Environment
# Loaded when NODE_ENV=development
# =============================================================

APP_NAME=ATLAS API (Dev)
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

THROTTLE_TTL=60
THROTTLE_LIMIT=1000

DATABASE_URL=postgresql://atlas_user:atlas_password@localhost:5433/atlas_db?schema=atlas

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=atlas_redis_password

JWT_SECRET=atlas-dev-jwt-secret-minimum-32-chars-change-for-prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=atlas-dev-refresh-secret-min-32-chars-change-prod
JWT_REFRESH_EXPIRES_IN=30d

LOG_LEVEL=debug

SWAGGER_ENABLED=true
SWAGGER_TITLE=ATLAS API – Development
SWAGGER_DESCRIPTION=ATLAS AI Commerce Operating System API (Development)
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs

# ── Amazon SP-API (global app-level credentials) ─────────────
# Fill in manually — not invented here. App boots fine without
# these; Amazon SP-API calls fail until both are set.
AMAZON_SP_API_CLIENT_ID=amzn1.application-oa2-client.e66daa658bdf430bba053a630af56958
AMAZON_SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.cdaaf9e07a896180d67cde4f6cbf477f71f2c408528578e03d700e6113d383a5
AMAZON_SP_API_ENVIRONMENT=sandbox
# Seller Central "Application ID" (Develop Apps) — NOT the same as the LWA
# client ID above. Fill in manually.
AMAZON_SP_API_APPLICATION_ID=amzn1.sp.solution.407a4552-3df6-454a-b114-0d9f51fe2e93
AMAZON_SP_API_REDIRECT_URI=http://localhost:3001/api/v1/marketplace-adapter/amazon/oauth/callback
