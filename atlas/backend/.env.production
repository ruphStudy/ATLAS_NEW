# =============================================================
# ATLAS – Production Environment Template
# DO NOT commit actual secret values.
# Populate via CI/CD secret injection or a secrets manager.
# =============================================================

APP_NAME=ATLAS API
NODE_ENV=production
PORT=3001
API_PREFIX=api
API_VERSION=1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://app.yourdomain.com

THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Database ─────────────────────────────────────────────────
# Use a connection pool URL (e.g. PgBouncer / RDS Proxy)
DATABASE_URL=INJECT_FROM_SECRET_MANAGER

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=INJECT_FROM_SECRET_MANAGER
REDIS_PORT=6379
REDIS_PASSWORD=INJECT_FROM_SECRET_MANAGER

# ── JWT ──────────────────────────────────────────────────────
# Minimum 64 characters in production
JWT_SECRET=INJECT_FROM_SECRET_MANAGER
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=INJECT_FROM_SECRET_MANAGER
JWT_REFRESH_EXPIRES_IN=30d

# ── Logger ───────────────────────────────────────────────────
LOG_LEVEL=info

# ── Swagger ──────────────────────────────────────────────────
# Disable Swagger in production for security
SWAGGER_ENABLED=false
SWAGGER_TITLE=ATLAS API
SWAGGER_DESCRIPTION=ATLAS AI Commerce Operating System API
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs
